{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upstreamdrift.dev/schemas/upstreamdrift-companion-v1.schema.json",
  "title": "UpstreamDrift Companion Manifest v1",
  "description": "Strict software-fact authority exported by UpstreamDrift for immutable AffineDrift consumption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "publication",
    "source",
    "providers",
    "registries",
    "compatibility",
    "engines",
    "programs",
    "features",
    "documentation",
    "workflows",
    "screenshots",
    "summary"
  ],
  "properties": {
    "$schema": {
      "const": "https://upstreamdrift.dev/schemas/upstreamdrift-companion-v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "const": "upstreamdrift-companion"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "registries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registry"
      }
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "engines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/engine"
      }
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "documentation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/documentation"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow"
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screenshot"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blockers"],
      "properties": {
        "state": {
          "enum": ["draft", "qualified"]
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "qualified"
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "commit_timestamp",
        "package_version",
        "generator",
        "inputs"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "commit_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "package_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "generator": {
          "$ref": "#/$defs/generator"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/input"
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "relationship",
        "pin_kind",
        "vendor_path",
        "pinned_commit"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "relationship": {
          "enum": ["authority", "vendored-provider"]
        },
        "pin_kind": {
          "enum": ["source-commit", "gitlink"]
        },
        "vendor_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/repoPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "pinned_commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "version", "discovery_mode"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "version": {
          "type": ["string", "null"]
        },
        "discovery_mode": {
          "const": "local-only"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments"],
      "properties": {
        "executable": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_python",
        "supported_python_minors",
        "verification_command"
      ],
      "properties": {
        "requires_python": {
          "description": "PEP 440 Python specifier copied verbatim from the provider's pyproject.toml [project].requires-python. Deliberately not a const: the exact value is derived from pyproject at export time and asserted against it by tests/companion/test_companion_catalog.py, so this schema never duplicates the version literal.",
          "type": "string",
          "pattern": "^>=\\d+\\.\\d+(,<\\d+\\.\\d+)?$"
        },
        "supported_python_minors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "uniqueItems": true
        },
        "verification_command": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "scope", "limitations"],
      "properties": {
        "state": {
          "enum": ["unqualified", "qualified", "rejected"]
        },
        "scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "support_tier", "scientific_qualification"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "support_tier": {
          "enum": ["supported", "extended", "experimental"]
        },
        "scientific_qualification": {
          "$ref": "#/$defs/qualification"
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "enum": ["available", "conditional", "unavailable"]
        },
        "reason": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "path"],
      "properties": {
        "registry": {
          "enum": ["launcher_manifest", "model_registry"]
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "category",
        "type",
        "entry_point",
        "engine_id",
        "provider_id",
        "hidden",
        "maturity",
        "availability",
        "support_tier",
        "scientific_qualification",
        "feature_ids",
        "legacy_statuses",
        "source_records"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "category": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "entry_point": {
          "oneOf": [
            {
              "$ref": "#/$defs/repoPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "engine_id": {
          "type": ["string", "null"]
        },
        "provider_id": {
          "$ref": "#/$defs/identifier"
        },
        "hidden": {
          "type": "boolean"
        },
        "maturity": {
          "enum": [
            "stable",
            "beta",
            "experimental",
            "deprecated",
            "unclassified"
          ]
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "support_tier": {
          "enum": ["supported", "extended", "experimental", "not_applicable"]
        },
        "scientific_qualification": {
          "$ref": "#/$defs/qualification"
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "legacy_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRecord"
          }
        }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "issue", "reason", "pending_decision"],
      "properties": {
        "state": {
          "enum": ["parity", "gap", "exempt", "api_only"]
        },
        "issue": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "reason": {
          "type": ["string", "null"]
        },
        "pending_decision": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "gap"
              }
            }
          },
          "then": {
            "properties": {
              "issue": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "exempt"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "path"],
      "properties": {
        "surface": {
          "enum": ["pyqt", "api", "web"]
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "parity",
        "program_ids",
        "surfaces",
        "notes",
        "scientific_qualification"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "parity": {
          "$ref": "#/$defs/parity"
        },
        "program_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface"
          }
        },
        "notes": {
          "type": ["string", "null"]
        },
        "scientific_qualification": {
          "$ref": "#/$defs/qualification"
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "source_path", "source_commit"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_path": {
          "$ref": "#/$defs/repoPath"
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "workflowEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit", "fixed", "python_paths"],
      "properties": {
        "inherit": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "uniqueItems": true
        },
        "fixed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "MPLBACKEND": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "PYTHONHASHSEED": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "PYTHONPATH": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "PYTHONDONTWRITEBYTECODE": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "PYTHONUTF8": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "python_paths": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "."
              },
              {
                "$ref": "#/$defs/repoPath"
              }
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "workflowArtifactVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "minimum_bytes"],
      "properties": {
        "method": {
          "enum": [
            "csv-header",
            "json-object",
            "non-empty",
            "png-signature",
            "sha256-sidecar"
          ]
        },
        "minimum_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "required_columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      }
    },
    "workflowArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "required", "verification"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "type": {
          "enum": ["csv", "json", "markdown", "png", "sha256"]
        },
        "required": {
          "type": "boolean"
        },
        "verification": {
          "$ref": "#/$defs/workflowArtifactVerification"
        }
      }
    },
    "workflowDeterminism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_kind",
        "fixture_paths",
        "absolute_tolerance",
        "relative_tolerance"
      ],
      "properties": {
        "fixture_kind": {
          "enum": ["inline", "repository"]
        },
        "fixture_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repoPath"
          },
          "uniqueItems": true
        },
        "absolute_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "relative_tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "executor",
        "argv",
        "cwd",
        "environment",
        "expected_exit_code",
        "expected_artifacts",
        "documentation_paths",
        "program_ids",
        "prerequisites",
        "support_tier",
        "availability",
        "determinism",
        "verification_method",
        "scientific_limitations",
        "source_commit"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": ["workflow", "failure-fixture"]
        },
        "failure_class": {
          "enum": [
            "bad-input",
            "stale-version",
            "unavailable-engine",
            "unsupported-dependency"
          ]
        },
        "executor": {
          "enum": ["python-module", null]
        },
        "argv": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "cwd": {
          "anyOf": [
            {
              "const": "."
            },
            {
              "$ref": "#/$defs/repoPath"
            }
          ]
        },
        "environment": {
          "$ref": "#/$defs/workflowEnvironment"
        },
        "expected_exit_code": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        },
        "expected_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflowArtifact"
          }
        },
        "documentation_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repoPath"
          },
          "uniqueItems": true
        },
        "program_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "support_tier": {
          "enum": ["supported", "extended", "experimental", "not_applicable"]
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "determinism": {
          "$ref": "#/$defs/workflowDeterminism"
        },
        "verification_method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "scientific_limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "failure-fixture"
              }
            }
          },
          "then": {
            "required": ["failure_class"],
            "properties": {
              "expected_exit_code": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "properties": {
                  "state": {
                    "const": "unavailable"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "executor": {
                "const": null
              },
              "argv": {
                "maxItems": 0
              },
              "expected_exit_code": {
                "const": null
              },
              "expected_artifacts": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program_id", "path", "sha256", "source_commit"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "program_id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_launcher_records",
        "local_model_records",
        "program_records",
        "feature_records",
        "feature_surface_paths",
        "workflow_records",
        "executable_workflow_records"
      ],
      "properties": {
        "raw_launcher_records": {
          "type": "integer",
          "minimum": 0
        },
        "local_model_records": {
          "type": "integer",
          "minimum": 0
        },
        "program_records": {
          "type": "integer",
          "minimum": 0
        },
        "feature_records": {
          "type": "integer",
          "minimum": 0
        },
        "feature_surface_paths": {
          "type": "integer",
          "minimum": 0
        },
        "workflow_records": {
          "type": "integer",
          "minimum": 0
        },
        "executable_workflow_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
