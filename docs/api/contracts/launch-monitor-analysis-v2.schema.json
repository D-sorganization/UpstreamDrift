{
  "$defs": {
    "AnalysisLineageV2": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetAuthorityV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "backing_records": {
          "items": {
            "$ref": "#/$defs/BackingRecordV2"
          },
          "title": "Backing Records",
          "type": "array"
        },
        "dataset_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Fingerprint Sha256",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceFileReferenceV2"
          },
          "title": "Sources",
          "type": "array"
        },
        "transformations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TransformRecordV2"
          },
          "title": "Transformations",
          "type": "array"
        }
      },
      "required": ["dataset_fingerprint_sha256", "backing_records"],
      "title": "AnalysisLineageV2",
      "type": "object"
    },
    "AvailabilityV2": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "observed_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Count"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "required_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Count"
        },
        "result_path": {
          "title": "Result Path",
          "type": "string"
        },
        "state": {
          "enum": ["available", "unavailable"],
          "title": "State",
          "type": "string"
        }
      },
      "required": ["result_path", "state"],
      "title": "AvailabilityV2",
      "type": "object"
    },
    "BackingRecordV2": {
      "additionalProperties": false,
      "description": "Stable reference to exactly one input record without copying values.",
      "properties": {
        "record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "shot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shot Id"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Row"
        },
        "unlinked_reason": {
          "anyOf": [
            {
              "enum": [
                "no_source_reference_declared",
                "session_not_linked_to_source_reference"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unlinked Reason"
        }
      },
      "required": ["record_sha256"],
      "title": "BackingRecordV2",
      "type": "object"
    },
    "ClaimsV2": {
      "additionalProperties": false,
      "properties": {
        "causal_inference": {
          "default": false,
          "title": "Causal Inference",
          "type": "boolean"
        },
        "device_certification": {
          "default": false,
          "title": "Device Certification",
          "type": "boolean"
        },
        "device_emulation": {
          "default": false,
          "title": "Device Emulation",
          "type": "boolean"
        },
        "vendor_comparison": {
          "default": "descriptive",
          "enum": ["descriptive", "matched_agreement"],
          "title": "Vendor Comparison",
          "type": "string"
        }
      },
      "title": "ClaimsV2",
      "type": "object"
    },
    "DatasetAuthorityV2": {
      "additionalProperties": false,
      "description": "Commit-addressable authority for the analyzed dataset.",
      "properties": {
        "commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Path"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Sha256"
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        }
      },
      "required": ["dataset_id"],
      "title": "DatasetAuthorityV2",
      "type": "object"
    },
    "MetricUnitsV2": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": ["canonical_registry", "source_declared", "unknown"],
          "title": "Authority",
          "type": "string"
        },
        "canonical_unit": {
          "title": "Canonical Unit",
          "type": "string"
        },
        "display_unit": {
          "title": "Display Unit",
          "type": "string"
        }
      },
      "required": ["canonical_unit", "display_unit", "authority"],
      "title": "MetricUnitsV2",
      "type": "object"
    },
    "MissingnessV2": {
      "additionalProperties": false,
      "properties": {
        "complete_row_count": {
          "minimum": 0,
          "title": "Complete Row Count",
          "type": "integer"
        },
        "excluded_by_reason": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Excluded By Reason",
          "type": "object"
        },
        "input_row_count": {
          "minimum": 0,
          "title": "Input Row Count",
          "type": "integer"
        },
        "missing_by_variable": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Missing By Variable",
          "type": "object"
        },
        "non_numeric_by_variable": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Non Numeric By Variable",
          "type": "object"
        },
        "policy": {
          "enum": ["pairwise", "listwise", "fail"],
          "title": "Policy",
          "type": "string"
        }
      },
      "required": [
        "input_row_count",
        "complete_row_count",
        "missing_by_variable",
        "non_numeric_by_variable",
        "excluded_by_reason",
        "policy"
      ],
      "title": "MissingnessV2",
      "type": "object"
    },
    "ModelProvenanceV2": {
      "additionalProperties": false,
      "properties": {
        "code_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Commit"
        },
        "configuration_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Sha256"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "relationship_to_vendor": {
          "default": "unknown",
          "enum": [
            "independent_physics",
            "vendor_comparable_surrogate",
            "vendor_reported_output",
            "unknown"
          ],
          "title": "Relationship To Vendor",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": ["model_id", "version"],
      "title": "ModelProvenanceV2",
      "type": "object"
    },
    "OrderEvidenceV2": {
      "additionalProperties": false,
      "description": "Evidence defining chronological or ordinal order for longitudinal work.",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "order_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Column"
        },
        "order_kind": {
          "anyOf": [
            {
              "enum": ["timestamp", "ordinal", "source_sequence"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Kind"
        },
        "trust_level": {
          "default": "not_provided",
          "enum": [
            "not_provided",
            "explicit_user_attested",
            "source_reported",
            "verified_external",
            "untrusted_inferred"
          ],
          "title": "Trust Level",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "title": "OrderEvidenceV2",
      "type": "object"
    },
    "PlayerIdentityV2": {
      "additionalProperties": false,
      "description": "Declared identity evidence; identity is never inferred from layout.",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "identifier_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicit player identifier column; session, club, source, file, and row-position fields are forbidden.",
          "not": {
            "enum": [
              "club",
              "club_id",
              "file",
              "file_name",
              "filename",
              "row_order",
              "session",
              "session_id",
              "source",
              "source_id",
              "source_row"
            ]
          },
          "title": "Identifier Column"
        },
        "trust_level": {
          "default": "not_provided",
          "enum": [
            "not_provided",
            "explicit_user_attested",
            "pseudonymous_stable",
            "verified_external",
            "untrusted_inferred"
          ],
          "title": "Trust Level",
          "type": "string"
        }
      },
      "title": "PlayerIdentityV2",
      "type": "object"
    },
    "SessionIdentityV2": {
      "additionalProperties": false,
      "description": "Evidence for repeated-observation session boundaries, never a player ID.",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "identifier_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier Column"
        },
        "trust_level": {
          "default": "not_provided",
          "enum": [
            "not_provided",
            "explicit_user_attested",
            "source_reported",
            "verified_external",
            "untrusted_inferred"
          ],
          "title": "Trust Level",
          "type": "string"
        }
      },
      "title": "SessionIdentityV2",
      "type": "object"
    },
    "SourceFileReferenceV2": {
      "additionalProperties": false,
      "description": "Content-addressed source and the sessions it backs.",
      "properties": {
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "rights_status": {
          "default": "unknown",
          "enum": [
            "public_redistributable",
            "restricted_internal",
            "permission_required",
            "unknown"
          ],
          "title": "Rights Status",
          "type": "string"
        },
        "session_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Session Ids",
          "type": "array"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        }
      },
      "required": ["source_id", "file_sha256"],
      "title": "SourceFileReferenceV2",
      "type": "object"
    },
    "TransformRecordV2": {
      "additionalProperties": false,
      "description": "Versioned transformation applied before analysis.",
      "properties": {
        "parameters_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameters Sha256",
          "type": "string"
        },
        "transform_id": {
          "minLength": 1,
          "title": "Transform Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": ["transform_id", "version", "parameters_sha256"],
      "title": "TransformRecordV2",
      "type": "object"
    },
    "UncertaintyV2": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "confidence_level": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "title": "Confidence Level",
          "type": "number"
        },
        "correlation_interval": {
          "title": "Correlation Interval",
          "type": "string"
        },
        "multiplicity_adjustment": {
          "title": "Multiplicity Adjustment",
          "type": "string"
        },
        "regression_interval": {
          "title": "Regression Interval",
          "type": "string"
        }
      },
      "required": [
        "confidence_level",
        "correlation_interval",
        "regression_interval",
        "multiplicity_adjustment",
        "assumptions"
      ],
      "title": "UncertaintyV2",
      "type": "object"
    },
    "VendorProvenanceV2": {
      "additionalProperties": false,
      "properties": {
        "metric_statuses": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Metric Statuses",
          "type": "object"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "row_count": {
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "software_versions": {
          "items": {
            "type": "string"
          },
          "title": "Software Versions",
          "type": "array"
        },
        "vendor": {
          "title": "Vendor",
          "type": "string"
        }
      },
      "required": [
        "vendor",
        "models",
        "software_versions",
        "row_count",
        "metric_statuses"
      ],
      "title": "VendorProvenanceV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete OpenAPI-compatible v2 result envelope.",
  "properties": {
    "analysis": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Analysis"
    },
    "availability": {
      "items": {
        "$ref": "#/$defs/AvailabilityV2"
      },
      "title": "Availability",
      "type": "array"
    },
    "claims": {
      "$ref": "#/$defs/ClaimsV2"
    },
    "contract_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/AnalysisLineageV2"
    },
    "missingness": {
      "$ref": "#/$defs/MissingnessV2"
    },
    "model_provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelProvenanceV2"
      },
      "title": "Model Provenance",
      "type": "array"
    },
    "order_evidence": {
      "$ref": "#/$defs/OrderEvidenceV2"
    },
    "player_identity": {
      "$ref": "#/$defs/PlayerIdentityV2"
    },
    "session_identity": {
      "$ref": "#/$defs/SessionIdentityV2"
    },
    "status": {
      "enum": ["available", "partial", "unavailable"],
      "title": "Status",
      "type": "string"
    },
    "uncertainty": {
      "$ref": "#/$defs/UncertaintyV2"
    },
    "units": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricUnitsV2"
      },
      "title": "Units",
      "type": "object"
    },
    "vendor_provenance": {
      "items": {
        "$ref": "#/$defs/VendorProvenanceV2"
      },
      "title": "Vendor Provenance",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "analysis",
    "units",
    "lineage",
    "missingness",
    "availability",
    "uncertainty",
    "player_identity",
    "vendor_provenance"
  ],
  "title": "LaunchMonitorAnalysisResultV2",
  "type": "object"
}
