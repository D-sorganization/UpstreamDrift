"""Prepare one source-bound Drake zero-effort acceleration observation.

This diagnostic reuses the exact candidate, source bootstrap, and geometry
observer receipts. It performs one instantaneous constrained-acceleration
evaluation after finite kinematic closure/rank/contact checks. It does not
integrate, project, optimize, or claim physical qualification.
"""

from __future__ import annotations

import argparse
import importlib
import importlib.metadata
import json
import platform
import sys
import sysconfig
from datetime import UTC, datetime
from pathlib import Path
from typing import Any, Mapping

import numpy as np

import drake_v1_candidate_lift_geometry_20261012 as geometry_probe
import pinocchio_fullbody_source_assembly_20261012 as source_setup
import pinocchio_v1_candidate_lift_parity_20261012 as candidate_probe


PINOCCHIO_GEOMETRY_RECEIPT_SHA256 = (
    "55ee3bad5c440f529bcf12226ab62984e031c7651b4fd1ba97d53735c097eb92"
)
PINOCCHIO_ZERO_EFFORT_RECEIPT_SHA256 = (
    "7bf8d34656683d0e6624eea6d34ba6ac0ce37e5ec868f9ecb3e385915be62e0f"
)
MUJOCO_GEOMETRY_RECEIPT_SHA256 = (
    "9986c0791134234f3d3b4e19b2784b48d3758965f1f5fbac23261211f5922ac3"
)
EXPECTED_GEOMETRY_PROBE_SHA256 = (
    "a8ed9212f6f709a1ec21d63cbe6757eeef34a144537b7fbe3b0cdccb6106b870"
)
EXPECTED_CANDIDATE_PROBE_SHA256 = (
    "40c521457a251cf9b5c905a950a3806d9573ccf8a34e4a1a09d5e3948bedb2b1"
)


def validate_zero_effort_input(
    coordinate_order: tuple[str, ...],
    coordinates: Mapping[str, float],
    rates: Mapping[str, float],
    efforts: Mapping[str, float],
) -> None:
    """Require complete finite source-ordered 41-state and zero v/tau."""
    if len(coordinate_order) != 41 or len(set(coordinate_order)) != 41:
        raise ValueError("input must use the exact 41 unique source coordinates")
    expected = set(coordinate_order)
    for label, values in (("q", coordinates), ("v", rates), ("tau", efforts)):
        if set(values) != expected:
            raise ValueError(f"{label} keys differ from complete source coordinates")
        if not np.isfinite(np.asarray([values[name] for name in coordinate_order])).all():
            raise ValueError(f"{label} must be finite")
    if any(
        tuple(values) != coordinate_order
        for values in (coordinates, rates, efforts)
    ):
        raise ValueError("q, v, and tau mappings must preserve exact source order")
    if any(float(rates[name]) != 0.0 for name in coordinate_order):
        raise ValueError("the retained manufactured pose requires exact zero rates")
    if any(float(efforts[name]) != 0.0 for name in coordinate_order):
        raise ValueError("this observation requires exact zero generalized effort")


def validate_geometry_preconditions(
    weld: Mapping[str, Any], contacts: Mapping[str, Any]
) -> None:
    """Require finite kinematics and six independent weld rows before solve."""
    residual = np.asarray(
        weld.get("pose_residual_translation_then_rotation_vector_frame_a"),
        dtype=np.float64,
    )
    rate = np.asarray(weld.get("rate_residual_linear_then_angular_frame_a"), dtype=np.float64)
    svd = weld.get("native_spatial_jacobian_svd")
    if residual.shape != (6,) or rate.shape != (6,) or not np.isfinite(np.r_[residual, rate]).all():
        raise ValueError("kinematic weld observations must be finite six-vectors")
    if not isinstance(svd, Mapping) or svd.get("shape") != [6, 41] or svd.get("rank") != 6:
        raise ValueError("the six-row source weld Jacobian must have rank six")
    sphere_rows = contacts.get("spheres")
    if contacts.get("sphere_count") != 4 or not isinstance(sphere_rows, Mapping) or len(sphere_rows) != 4:
        raise ValueError("the frozen source must expose exactly four sphere contacts")
    for name, row in sphere_rows.items():
        if not isinstance(row, Mapping):
            raise ValueError(f"contact sample {name} is malformed")
        arrays = [
            np.asarray(row.get(field), dtype=np.float64)
            for field in ("contact_point_world_m", "normal_force_n", "friction_force_n")
        ]
        scalars = [row.get("penetration_m"), row.get("penetration_rate_m_s")]
        if any(value.shape != (3,) for value in arrays) or not np.isfinite(
            np.r_[*arrays, scalars].astype(np.float64)
        ).all():
            raise ValueError(f"contact sample {name} is nonfinite or malformed")


def snapshot_artifacts(paths: Mapping[str, Path]) -> dict[str, str]:
    """Hash reviewed helpers and data at the pre-model checkpoint."""
    return {name: source_setup.sha(path) for name, path in paths.items()}


def artifacts_unchanged(before: Mapping[str, str], after: Mapping[str, str]) -> bool:
    """Require identical artifact identities and bytes across the native call."""
    return dict(before) == dict(after)


def verify_api_module_origin(package_init: Path, api_module: Path) -> Path:
    """Require pydrake.all to load from the pinned installed pydrake package."""
    package_root = package_init.resolve().parent
    module_path = api_module.resolve()
    try:
        module_path.relative_to(package_root)
    except ValueError as exc:
        raise ImportError("pydrake.all resolved outside the installed pydrake package") from exc
    if not module_path.is_file():
        raise ImportError("pydrake.all source module is missing")
    return module_path


def observe_one_zero_effort_acceleration(
    owner: Any,
    coordinate_order: tuple[str, ...],
    coordinates: Mapping[str, float],
    rates: Mapping[str, float],
    efforts: Mapping[str, float],
    weld: Mapping[str, Any],
    contacts: Mapping[str, Any],
) -> dict[str, Any]:
    """Call native adapter dynamics exactly once after all input/geometry gates."""
    validate_zero_effort_input(coordinate_order, coordinates, rates, efforts)
    if tuple(owner.coordinate_order) != coordinate_order:
        raise ValueError("adapter coordinate order differs from frozen source")
    validate_geometry_preconditions(weld, contacts)
    mass = float(owner.mass_kg)
    if not np.isfinite(mass) or mass <= 0.0:
        raise ValueError("adapter total mass must be finite and positive")

    named_acceleration = owner.accelerations(coordinates, rates, efforts)
    if not isinstance(named_acceleration, Mapping) or set(named_acceleration) != set(coordinate_order):
        raise ValueError("native acceleration output must cover every source coordinate")
    qdd = np.asarray([named_acceleration[name] for name in coordinate_order], dtype=np.float64)
    if qdd.shape != (41,) or not np.isfinite(qdd).all():
        raise FloatingPointError("native acceleration output must be finite and 41-dimensional")
    return {
        "call_count": 1,
        "source_coordinate_order": list(coordinate_order),
        "qdd_named_source_order": {
            name: float(value) for name, value in zip(coordinate_order, qdd, strict=True)
        },
        "qdd_source_order": qdd.tolist(),
        "qdd_basis_note": (
            "Drake generalized-coordinate accelerations in FullBodySpec source order; "
            "root angular/translation components are not asserted equal to another "
            "engine's spatial/world acceleration basis."
        ),
        "adapter_total_mass_kg": mass,
        "adapter_recomputes_shared_contact_law_at_same_q_v": True,
        "weld_multiplier_or_kkt_residual_exposed_by_adapter": False,
    }


def observe(repo: Path, output: Path, script_path: Path) -> dict[str, Any]:
    """Build exact frozen adapter, gate on geometry, then observe one qdd."""
    if output.exists():
        raise FileExistsError("output receipt path must be fresh; no overwrite")
    source_hashes = source_setup.verify_sources(repo)
    drake_hashes = geometry_probe.verify_drake_sources(repo)
    geometry_path = Path(candidate_probe.OBSERVATION)
    candidate_path = Path(candidate_probe.CANDIDATE)
    geometry_sha = candidate_probe.verify_artifact(
        geometry_path, candidate_probe.OBSERVATION_SHA256, "candidate-lift geometry receipt"
    )
    candidate_sha = candidate_probe.verify_artifact(
        candidate_path, candidate_probe.CANDIDATE_SHA256, "external candidate JSON"
    )
    helper_path = Path(source_setup.__file__).resolve()
    candidate_probe_path = Path(candidate_probe.__file__).resolve()
    geometry_probe_path = Path(geometry_probe.__file__).resolve()
    if geometry_probe.sha256_file(geometry_probe_path) != EXPECTED_GEOMETRY_PROBE_SHA256:
        raise RuntimeError("reviewed Drake geometry observer changed")
    if candidate_probe.sha256_file(candidate_probe_path) != EXPECTED_CANDIDATE_PROBE_SHA256:
        raise RuntimeError("reviewed candidate probe changed")
    if source_setup.sha(helper_path) != candidate_probe.SOURCE_HELPER_SHA256:
        raise RuntimeError("source bootstrap helper digest differs from reviewed value")
    spec_path = repo / candidate_probe.SPEC
    upper_path = repo / candidate_probe.UPPER
    spec_sha = candidate_probe.verify_artifact(
        spec_path, candidate_probe.EXPECTED_SPEC_SHA256, "full-body specification"
    )
    upper_sha = candidate_probe.verify_artifact(
        upper_path, candidate_probe.UPPER_SHA256, "upper-body geometry"
    )
    artifact_paths = {
        "candidate_geometry_receipt": geometry_path,
        "candidate": candidate_path,
        "spec": spec_path,
        "upper_geometry": upper_path,
        "source_bootstrap": helper_path,
        "candidate_probe": candidate_probe_path,
        "geometry_observer": geometry_probe_path,
        "zero_effort_observer": script_path,
    }
    artifact_before = snapshot_artifacts(artifact_paths)
    geometry = json.loads(geometry_path.read_text(encoding="utf-8"))
    candidate = json.loads(candidate_path.read_text(encoding="utf-8"))

    try:
        drake_version = geometry_probe.require_supported_drake_version(
            importlib.metadata.version("drake")
        )
    except importlib.metadata.PackageNotFoundError as exc:
        raise RuntimeError("reviewed Drake 1.57.x distribution is not installed") from exc
    spec_module = importlib.import_module("src.shared.python.motion_matching.full_body_spec")
    expected_spec_module = (repo / "src/shared/python/motion_matching/full_body_spec.py").resolve()
    if Path(spec_module.__file__).resolve() != expected_spec_module:
        raise RuntimeError("full-body spec helper imported outside exact source archive")
    spec = spec_module.load_full_body_spec(
        spec_path, json.loads(upper_path.read_text(encoding="utf-8"))
    )
    order = tuple(spec["coordinate_order"])
    coordinates, rates = candidate_probe.candidate_named_state(
        geometry, order, tuple(candidate["coordinate_names"])
    )
    efforts = dict.fromkeys(order, 0.0)
    validate_zero_effort_input(order, coordinates, rates, efforts)

    source_import_paths = source_setup.install_source_import_paths(repo)
    import pydrake

    api = importlib.import_module("pydrake.all")
    if not hasattr(api, "MultibodyPlant") or not hasattr(api, "JacobianWrtVariable"):
        raise ImportError("real pydrake public kinematics APIs are unavailable")
    pydrake_path = geometry_probe.verify_pydrake_origin(
        repo,
        Path(sys.prefix),
        Path(sysconfig.get_paths()["purelib"]),
        Path(pydrake.__file__),
        str(api.MultibodyPlant.__module__),
    )
    model_module = importlib.import_module(
        "src.engines.physics_engines.drake.python.full_body_model"
    )
    model_path = Path(model_module.__file__).resolve()
    if model_path != (repo / "src/engines/physics_engines/drake/python/full_body_model.py").resolve():
        raise RuntimeError("Drake model adapter imported outside exact source archive")
    api_path = verify_api_module_origin(pydrake_path, Path(str(api.__file__)))
    artifact_paths["pydrake_package_init"] = pydrake_path
    artifact_paths["pydrake_all_module"] = api_path
    artifact_before.update(snapshot_artifacts({
        "pydrake_package_init": pydrake_path,
        "pydrake_all_module": api_path,
    }))

    owner = model_module.FullBodyDrakeModel(spec)
    contacts = geometry_probe.drake_contact_observation(owner, coordinates, rates)
    weld = geometry_probe.drake_weld_observation(owner, api, coordinates, rates, order)
    # The preceding adapter method is explicitly kinematics-only. Dynamics is
    # reached once, only after complete 41-state, finite contact, and rank-six gates.
    dynamics = observe_one_zero_effort_acceleration(
        owner, order, coordinates, rates, efforts, weld, contacts
    )
    result: dict[str, Any] = {
        "schema_version": "drake-candidate-lift-zero-effort-acceleration-v1",
        "created_utc": datetime.now(UTC).isoformat(),
        "status": "observed_one_zero_effort_acceleration",
        "qualification": "none; one instantaneous manufactured-state diagnostic",
        "source_commit": source_setup.COMMIT,
        "base_manifest_sha256": source_setup.MANIFEST_SHA256,
        "source_hashes": source_hashes,
        "drake_source_hashes": drake_hashes,
        "source_import_paths": list(source_import_paths),
        "input_artifacts": {
            "candidate_geometry_receipt_sha256": geometry_sha,
            "candidate_sha256": candidate_sha,
            "full_body_spec_sha256": spec_sha,
            "upper_geometry_sha256": upper_sha,
            "mujoco_geometry_receipt_sha256": MUJOCO_GEOMETRY_RECEIPT_SHA256,
            "pinocchio_geometry_receipt_sha256": PINOCCHIO_GEOMETRY_RECEIPT_SHA256,
            "pinocchio_zero_effort_receipt_sha256": PINOCCHIO_ZERO_EFFORT_RECEIPT_SHA256,
        },
        "observer_hashes": {
            "source_bootstrap_sha256": artifact_before["source_bootstrap"],
            "candidate_probe_sha256": artifact_before["candidate_probe"],
            "geometry_observer_sha256": artifact_before["geometry_observer"],
            "zero_effort_observer_sha256": artifact_before["zero_effort_observer"],
            "drake_model_module_sha256": source_setup.sha(model_path),
            "pydrake_package_init_sha256": artifact_before["pydrake_package_init"],
            "pydrake_api_module": str(api.MultibodyPlant.__module__),
            "pydrake_all_origin": str(api_path),
            "pydrake_all_sha256": artifact_before["pydrake_all_module"],
        },
        "runtime": {
            "python": sys.version,
            "platform": platform.platform(),
            "drake_distribution_version": drake_version,
            "pydrake_package_origin": str(pydrake_path),
            "drake_adapter_origin": str(model_path),
            "coordinate_acceleration_units": "source generalized-coordinate units per second squared",
        },
        "input": {
            "coordinate_order": list(order),
            "q_named": coordinates,
            "v_named_exact_zero": rates,
            "tau_named_exact_zero": efforts,
            "rate_count": len(rates),
            "generalized_effort_count": len(efforts),
        },
        "pre_dynamics_kinematics": {
            "weld": weld,
            "contacts": contacts,
            "gate": "finite complete inputs, four finite source contacts, six-row weld rank 6",
        },
        "dynamics": dynamics,
        "comparison": {
            "same_q_v_tau_as_retained_pinocchio_and_mujoco_candidate": True,
            "cross_engine_acceleration_equality_asserted": False,
            "weld_multiplier_or_kkt_residual_comparison": False,
            "physical_qualification": False,
        },
        "execution_limits": {
            "native_acceleration_calls": 1,
            "integration": False,
            "projection": False,
            "optimizer": False,
            "physical_qualification": False,
        },
    }
    source_after = source_setup.verify_sources(repo)
    drake_after = geometry_probe.verify_drake_sources(repo)
    artifact_after = snapshot_artifacts(artifact_paths)
    result["source_hashes_after"] = source_after
    result["drake_source_hashes_after"] = drake_after
    result["artifact_hashes_before"] = artifact_before
    result["artifact_hashes_after"] = artifact_after
    result["source_and_artifacts_unchanged"] = (
        source_hashes == source_after
        and drake_hashes == drake_after
        and artifacts_unchanged(artifact_before, artifact_after)
    )
    if not result["source_and_artifacts_unchanged"]:
        result["status"] = "provenance_changed"
    source_setup.write_json_atomic(output, result)
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-root", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    result = observe(args.repo_root.resolve(), args.output.resolve(), Path(__file__).resolve())
    print(json.dumps({"status": result["status"], "output": str(args.output.resolve())}))
    return 0 if result["status"] == "observed_one_zero_effort_acceleration" else 2


if __name__ == "__main__":
    raise SystemExit(main())
