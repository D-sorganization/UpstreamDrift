from __future__ import annotations

import subprocess
import hashlib
import tempfile
import unittest
from unittest.mock import patch
from pathlib import Path

from mujoco_candidate_lift_bootstrap import (
    canonical_pythonpath,
    bounded_child_environment,
    child_environment,
    recorded_environment,
    pinned_tools_root,
)


class BootstrapTests(unittest.TestCase):
    def setUp(self) -> None:
        self.temp = tempfile.TemporaryDirectory()
        self.root = Path(self.temp.name) / "repo"
        self.root.mkdir()
        self.planning = Path(self.temp.name) / "planning"
        self.planning.mkdir()
        (self.root / "pyproject.toml").write_text(
            '[tool.pytest.ini_options]\npythonpath = ["src", "tests/fixtures", "src"]\n',
            encoding="utf-8",
        )
        (self.root / "src").mkdir()
        (self.root / "tests" / "fixtures").mkdir(parents=True)
        self.tools = self.root / "vendor" / "ud-tools"
        self.tools.mkdir(parents=True)
        subprocess.run(["git", "init", str(self.tools)], check=True, capture_output=True)
        subprocess.run(["git", "-C", str(self.tools), "-c", "user.name=Test", "-c", "user.email=test@example.invalid", "commit", "--allow-empty", "-m", "pin"], check=True, capture_output=True)
        self.pin = subprocess.run(["git", "-C", str(self.tools), "rev-parse", "HEAD"], check=True, capture_output=True, text=True).stdout.strip()

    def tearDown(self) -> None:
        self.temp.cleanup()

    def test_pythonpath_preserves_configured_order_and_prepends_planning(self) -> None:
        result = canonical_pythonpath(self.root, self.planning)
        self.assertEqual(
            result,
            (
                str(self.planning.resolve()),
                str((self.root / "src").resolve()),
                str((self.root / "tests" / "fixtures").resolve()),
            ),
        )

    def test_missing_configured_entry_fails_closed(self) -> None:
        (self.root / "pyproject.toml").write_text(
            '[tool.pytest.ini_options]\npythonpath = ["src", "missing"]\n',
            encoding="utf-8",
        )
        with self.assertRaises(FileNotFoundError):
            canonical_pythonpath(self.root, self.planning)

    def test_changed_configuration_cannot_silently_drop_src(self) -> None:
        original_digest = hashlib.sha256((self.root / "pyproject.toml").read_bytes()).hexdigest()
        (self.root / "pyproject.toml").write_text(
            '[tool.pytest.ini_options]\npythonpath = ["tests/fixtures"]\n',
            encoding="utf-8",
        )
        with self.assertRaisesRegex(ValueError, "pyproject.toml SHA mismatch"):
            canonical_pythonpath(self.root, self.planning, original_digest)

    def test_tools_pin_and_clean_tree_are_required(self) -> None:
        self.assertEqual(pinned_tools_root(self.root, self.pin), self.tools.resolve())
        with self.assertRaisesRegex(ValueError, "pin mismatch"):
            pinned_tools_root(self.root, "0" * 40)
        (self.tools / "dirty.txt").write_text("changed", encoding="utf-8")
        with self.assertRaisesRegex(ValueError, "local changes"):
            pinned_tools_root(self.root, self.pin)

    def test_child_environment_uses_planning_source_paths_and_exact_tools_root(self) -> None:
        config_sha = hashlib.sha256((self.root / "pyproject.toml").read_bytes()).hexdigest()
        # Test fixture config is intentionally different from production pin.
        env = child_environment(
            self.root,
            self.planning,
            {"KEEP": "value"},
            self.pin,
            expected_pyproject_sha256=config_sha,
        )
        self.assertEqual(env["KEEP"], "value")
        self.assertEqual(env["TOOLS_REPO_PATH"], str(self.tools.resolve()))
        self.assertEqual(
            env["PYTHONPATH"].split(";"),
            [
                str(self.planning.resolve()),
                str((self.root / "src").resolve()),
                str((self.root / "tests" / "fixtures").resolve()),
            ],
        )

    def test_allowlisted_environment_drops_inherited_values_and_sets_caps_last(self) -> None:
        config_sha = hashlib.sha256((self.root / "pyproject.toml").read_bytes()).hexdigest()
        with patch.dict("os.environ", {"SENTINEL_SECRET": "must-not-leak", "OMP_NUM_THREADS": "99"}):
            env = bounded_child_environment(
                self.root,
                self.planning,
                ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS"),
                base={},
                expected_tools_commit=self.pin,
                expected_pyproject_sha256=config_sha,
            )
        self.assertNotIn("SENTINEL_SECRET", env)
        self.assertEqual(env["OMP_NUM_THREADS"], "1")
        self.assertEqual(env["OPENBLAS_NUM_THREADS"], "1")
        recorded = recorded_environment(env, ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "PYTHONPATH", "TOOLS_REPO_PATH"))
        self.assertNotIn("SENTINEL_SECRET", recorded)
        self.assertEqual(recorded["OMP_NUM_THREADS"], "1")


if __name__ == "__main__":
    unittest.main()
