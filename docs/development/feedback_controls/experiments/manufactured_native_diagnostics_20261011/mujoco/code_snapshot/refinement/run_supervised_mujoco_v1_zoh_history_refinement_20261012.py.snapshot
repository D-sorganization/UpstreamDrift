"""One owned 30 s / 1 GiB sampled process-tree run; no retry or escalation."""
from __future__ import annotations

import argparse
import hashlib
import json
import sys
import time
from pathlib import Path

from mujoco_candidate_lift_bootstrap import (
    EXPECTED_PYPROJECT_SHA256,
    EXPECTED_TOOLS_COMMIT,
    bounded_child_environment,
    canonical_pythonpath,
    pinned_tools_root,
    recorded_environment,
    tools_head,
    tools_status,
)

PLANNING = Path(r"C:/Users/diete/Repositories/docs/development/feedback_controls_planning")
REPO = Path(r"C:/Users/diete/Repositories/Worktrees/feedback-moco-state-binding-11791")
SUPERVISOR_REPO = Path(r"C:/Users/diete/Repositories/Worktrees/feedback-marker-calibration-12164")
SUPERVISOR_REL = Path("tests/opensim/native_moco_ladder_harness.py")
SUPERVISOR = SUPERVISOR_REPO / SUPERVISOR_REL
CHILD = Path(r"C:/Users/diete/Repositories/.venv-feedback-opensim/Scripts/python.exe")
MUJOCO_PACKAGE = CHILD.parent.parent / "Lib/site-packages/mujoco"
SPEC = REPO / "docs/development/full_body_models/full_body_spec_v1.json"
CANDIDATE = REPO / "docs/development/full_body_models/evidence/native_candidates/returned81_candidate.json"
SEED = PLANNING / "mujoco_v1_zero_effort_20261011_root_attempt2/native-observation.json"
PRIOR_SMOKE = PLANNING / "mujoco_v1_two_interval_pd_20261011_root_attempt1/native-observation.json"
PRIOR_BUNDLE = PLANNING / "mujoco_v1_two_interval_pd_20261011_root_attempt1/frozen-t01-bundle.json"
CORE = PLANNING / "mujoco_v1_zoh_history_refinement.py"
TESTS = PLANNING / "test_mujoco_v1_zoh_history_refinement.py"
DRIVER = PLANNING / "run_mujoco_v1_zoh_history_refinement_20261012.py"
WRAPPER = Path(__file__).resolve()
BOOTSTRAP = PLANNING / "mujoco_candidate_lift_bootstrap.py"
CONTROLLER = PLANNING / "mujoco_v1_two_interval_pd_smoke.py"
CONTROLLER_DRIVER = PLANNING / "run_mujoco_v1_two_interval_pd_smoke_20261012.py"
CONTROLLER_TESTS = PLANNING / "test_mujoco_v1_two_interval_pd_smoke.py"
PROTOCOL = PLANNING / "mujoco_v1_manufactured_seed_protocol_20261012.md"
BOOTSTRAP_SOURCES = tuple(REPO / rel for rel in (
    "pyproject.toml", "tests/conftest.py", "src/shared/python/_seam_redirect.py",
    "src/shared/python/__init__.py", "src/bunkershot3d/__init__.py",
    "src/shared/python/simulation_backends/wrench_extractor.py",
    "src/shared/python/biomechanics/__init__.py",
))
NATIVE_SOURCES = tuple(REPO / rel for rel in (
    "src/engines/native_replay_contracts.py",
    "src/engines/physics_engines/mujoco/python/native_full_body_replay.py",
    "src/engines/physics_engines/mujoco/python/full_body_model.py",
    "src/engines/physics_engines/mujoco/python/full_body_mjcf.py",
    "src/engines/physics_engines/mujoco/python/native_mjcf.py",
    "src/engines/physics_engines/mujoco/python/native_model.py",
    "src/shared/python/motion_matching/contact_law.py",
    "src/shared/python/motion_matching/constraint_kinematics.py",
    "src/shared/python/motion_matching/full_body_ik.py",
    "src/shared/python/motion_matching/same_input/__init__.py",
    "src/shared/python/motion_matching/same_input/plant.py",
    "src/shared/python/motion_matching/same_input/integrator.py",
))
FILE_SET = (SPEC, CANDIDATE, SEED, PRIOR_SMOKE, PRIOR_BUNDLE, CORE, TESTS, DRIVER, WRAPPER, BOOTSTRAP, CONTROLLER, CONTROLLER_DRIVER, CONTROLLER_TESTS, PROTOCOL, *BOOTSTRAP_SOURCES, *NATIVE_SOURCES)
THREAD_KEYS = ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS")
TIMEOUT_SECONDS = 30
SAMPLED_RSS_THRESHOLD_BYTES = 1 << 30


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def hashes(paths: tuple[Path, ...]) -> dict[str, str]:
    return {str(path.resolve()): sha256(path) for path in paths}


def mujoco_hashes() -> dict[str, str]:
    if not MUJOCO_PACKAGE.is_dir():
        raise FileNotFoundError("MuJoCo package is not present in the bound runtime")
    files = sorted(path for path in MUJOCO_PACKAGE.rglob("*") if path.is_file() and path.suffix.lower() in {".pyd", ".dll", ".so", ".dylib"})
    if not files:
        raise FileNotFoundError("no compiled MuJoCo modules found")
    return {str(path.resolve()): sha256(path) for path in files}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output-dir", type=Path, required=True)
    args = parser.parse_args()
    output_dir = args.output_dir.resolve()
    if output_dir.exists():
        parser.error("output directory must be fresh; no overwrite or retry")
    for path in (*FILE_SET, CHILD, SUPERVISOR):
        if not path.is_file():
            parser.error(f"required source or runtime file missing: {path}")
    output_dir.mkdir(parents=True, exist_ok=False)
    child_receipt = output_dir / "native-observation.json"
    sys.path.insert(0, str(SUPERVISOR_REPO))
    from tests.opensim.native_moco_ladder_harness import _WorkerTimeout, _supervise_process_tree

    before = hashes((*FILE_SET, CHILD, SUPERVISOR))
    native_before = mujoco_hashes()
    tools_root = pinned_tools_root(REPO)
    tools_before = tools_head(tools_root)
    tools_status_before = tools_status(tools_root)
    environment = bounded_child_environment(REPO, PLANNING, THREAD_KEYS, base={})
    environment.update({"PYTHONSAFEPATH": "1", "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8"})
    command = [str(CHILD), "-P", str(DRIVER), "--execute-native", "--output", str(child_receipt)]
    payload: dict[str, object] = {
        "schema_version": 1,
        "phase": "ten-ms-one-ms-record-ordinary-replay-and-frozen-history-16-substep-refinement",
        "status": "starting",
        "command": command,
        "cwd": str(PLANNING),
        "child_python": str(CHILD),
        "child_python_sha256": sha256(CHILD),
        "supervisor_path": str(SUPERVISOR),
        "supervisor_sha256": sha256(SUPERVISOR),
        "timeout_seconds": TIMEOUT_SECONDS,
        "sampled_owned_tree_rss_threshold_bytes": SAMPLED_RSS_THRESHOLD_BYTES,
        "thread_environment": recorded_environment(environment, (*THREAD_KEYS, "PYTHONPATH", "TOOLS_REPO_PATH", "PYTHONSAFEPATH", "PYTHONUTF8", "PYTHONIOENCODING")),
        "input_hashes_before": before,
        "canonical_pythonpath": list(canonical_pythonpath(REPO, PLANNING, EXPECTED_PYPROJECT_SHA256)),
        "tools_repo_path": str(tools_root),
        "tools_commit_expected": EXPECTED_TOOLS_COMMIT,
        "tools_commit_before": tools_before,
        "tools_status_before": tools_status_before,
        "mujoco_compiled_hashes_before": native_before,
        "started_unix_seconds": time.time(),
    }
    try:
        code, stdout, stderr, peak = _supervise_process_tree(command, PLANNING, TIMEOUT_SECONDS, SAMPLED_RSS_THRESHOLD_BYTES, env=environment)
        payload.update({"status": "exited", "returncode": code, "stdout": stdout, "stderr": stderr, "peak_sampled_owned_tree_rss_bytes": peak})
    except _WorkerTimeout as exc:
        payload.update({"status": "supervisor_stopped", "stop_reason": exc.stop_reason, "stdout": exc.stdout, "stderr": exc.stderr, "peak_sampled_owned_tree_rss_bytes": exc.peak_rss})
    finally:
        payload["ended_unix_seconds"] = time.time()
        payload["input_hashes_after"] = hashes((*FILE_SET, CHILD, SUPERVISOR))
        payload["inputs_unchanged"] = payload["input_hashes_before"] == payload["input_hashes_after"]
        tools_after = tools_head(tools_root)
        tools_status_after = tools_status(tools_root)
        payload["tools_commit_after"] = tools_after
        payload["tools_status_after"] = tools_status_after
        payload["tools_pin_unchanged"] = tools_before == tools_after == EXPECTED_TOOLS_COMMIT and tools_status_before == tools_status_after == ""
        native_after = mujoco_hashes()
        payload["mujoco_compiled_hashes_after"] = native_after
        payload["mujoco_binaries_unchanged"] = native_before == native_after
        payload["provenance_unchanged"] = bool(payload["inputs_unchanged"] and payload["mujoco_binaries_unchanged"] and payload["tools_pin_unchanged"])
        payload["child_receipt_present"] = child_receipt.is_file()
        if child_receipt.is_file():
            payload["child_receipt_path"] = str(child_receipt)
            payload["child_receipt_sha256"] = sha256(child_receipt)
        if not payload["provenance_unchanged"]:
            payload["status"] = "provenance_changed"
        (output_dir / "supervisor-receipt.json").write_text(json.dumps(payload, indent=2, sort_keys=True) + chr(10), encoding="utf-8")
    if payload.get("status") != "exited" or not payload.get("provenance_unchanged") or not payload.get("child_receipt_present"):
        return 1
    return int(payload.get("returncode", 1))


if __name__ == "__main__":
    raise SystemExit(main())
