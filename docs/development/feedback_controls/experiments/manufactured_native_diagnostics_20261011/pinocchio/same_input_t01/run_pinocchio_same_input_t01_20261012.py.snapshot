"""Prepare/run one pinned-source Pinocchio replay of the retained T01 table.

The runner is external diagnostic tooling. Its native mode is deliberately
source- and input-bound; unit tests exercise the same preflight/dispatch with
an instrumented fake plant and never import a physics engine.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib
import json
import os
import sys
from pathlib import Path
from typing import Any, Callable

import numpy as np

SOURCE_COMMIT = "9e5f87c4dd31fc3137fc204d98337633fa5c4855"
SOURCE_SETUP = "pinocchio_fullbody_source_assembly_20261012.py"
SOURCE_SETUP_SHA256 = "2d619a9540920cf7093af61a1cbc8cdf865b0ca7cc56c968c631e2f879c78cb3"
PLANT_PATH = "src/shared/python/motion_matching/same_input/plant.py"
INTEGRATOR_PATH = "src/shared/python/motion_matching/same_input/integrator.py"
ADAPTER_PATH = "src/engines/physics_engines/pinocchio/python/native_model.py"
EXPECTED = {
    "bundle": "e4a93dce80da2539b07f3a6c5f8f664389d77a55491e2b1f35002ca8782180a4",
    "observation": "6f8a369f2721a1ac3307a9b7172c7c2ead643f8f2e871e6289bc704c3d0d8acb",
    "facade": "e183d4d7b27799bd8790baa7e1c99d0aebeca9b709e0ec04554b8848059e1774",
    "source": {
        "src/shared/python/motion_matching/same_input/plant.py": "ff61ed1b6b98b85d7f4f118d44b470c5e9e4e744423c0052f926f6bf1a0826c5",
        "src/shared/python/motion_matching/same_input/integrator.py": "3fe57c6ebb939013b30b5b97bad6097821d8052eea21079b13a874b36c0c4bf9",
        "src/shared/python/motion_matching/same_input/closure.py": "77983f2018216d514d36d47d56d8f9c061f46ec69372189042c2ea4d3ad9679e",
        "src/engines/physics_engines/pinocchio/python/native_model.py": "782402d13c152c7bdd0bee76d7b084e3bef8a697cb5c5b0805021d0fd81c8a92",
        "src/shared/python/motion_matching/contact_law.py": "1edc287e4d4d12a58558f6fc62f4bd9d291908f4dcade4232bb6644883dbe43c",
        "docs/development/full_body_models/full_body_spec_v1.json": "09cff1393a48b7f44e2ceaac9132473c64a33f9f853823c5e7d7fef80802e6b3",
    },
}
BUNDLE_DIR = "mujoco_v1_zoh_history_refinement_20261011_root_attempt1"
FACADE_PATH = "src/shared/python/motion_matching/same_input/__init__.py"
POLICY = {
    "engine": "pinocchio",
    "engine_version": "3.8.0",
    "source_commit": SOURCE_COMMIT,
    "vendor_tools_commit": "86d0f28b1cc5acf61185e07e320c816c2d005512",
    "source_manifest_sha256": "c5ec40129d3b28368142eadfb33e8e1464f7c6e4d4505dd5a6d2f86870d4f569",
    "bundle_sha256": EXPECTED["bundle"],
    "observation_sha256": EXPECTED["observation"],
    "spec_sha256": EXPECTED["source"][
        "docs/development/full_body_models/full_body_spec_v1.json"
    ],
    "facade_sha256": EXPECTED["facade"],
    "source_setup_sha256": SOURCE_SETUP_SHA256,
    "input_policy": "zero_order_hold_saved_rows_0_through_9",
    "integrator": "public_open_loop_classical_rk4",
    "macro_step_seconds": 0.001,
    "substeps": 8,
    "project": False,
    "stop_on_failure": False,
