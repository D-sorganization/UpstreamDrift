{
  "schema_version": 1,
  "note": "Names, topology and signs only: no value, offset, mass or geometry of any licensed model is stored here. A sign is the observed direction of the target axis relative to the golf axis at the all-zero pose (native probe, checked by the asset-gated test); it is never assumed. See docs/research/segmental_spine/sections/spn-9c.tex.",
  "treatments": {
    "golf": {
      "direct": "target = sign * golf (one coordinate to one coordinate, no offset)",
      "pelvis_pose": "carried by the pelvis pose of the golf input (same ground-pelvis encoding in both models); sign is checked, not applied",
      "orientation_match": "the golf coordinates and the target coordinates parametrise one segment orientation with different Euler sequences; solved natively per frame (group in orientation_groups)",
      "spine_drive": "consumed by the segmental spine drive as the global pelvis-to-torso rotation",
      "excluded": "no driven target; reason recorded per coordinate"
    },
    "target": {
      "driven_by_pelvis_pose": "written from the golf pelvis pose",
      "driven_by_spine_drive": "written by the segmental spine drive",
      "driven_direct": "written from a golf coordinate with the recorded sign",
      "driven_orientation_match": "written by the per-frame segment-orientation solve",
      "held_neutral": "free in the asset, prescribed at the neutral value (zero) for the whole motion",
      "locked_in_asset": "locked in the asset file; never driven (rib coordinates, forearm and wrist, sternum translations, thoracic lateral-bending and axial-rotation levels T1_T2 to T11_T12, head-neck lateral and axial)"
    }
  },
