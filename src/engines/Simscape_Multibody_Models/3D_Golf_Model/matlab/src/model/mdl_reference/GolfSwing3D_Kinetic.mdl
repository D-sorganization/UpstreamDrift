__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_634.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="634">
  <P Name="name">RE Input Function/Right Elbow Input Torque</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">634</P>
  <P Name="ssIdHighWaterMark">42</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">12</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">634</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [JointTorqueRE,REPositionInput,REVelocityInput,...
    REAccelerationInput]  = fcn(Time,Killswitch,...
    REInputB,REPositionSetpoint,GlobalGain,...
    REDampening, ModelingMode,GlobalPCGain, GlobalVCGain,...
    DampeningGlobalGain,TargetImpactTime,KinematicMode, REAo,REStartPosition,...
    REStartVelocity,REVCGain,...
    TargetREVelocity,TargetREPosition, ...
    REPositionGain,REInputC,...
    RETimeGain, REConstant, REPosition,REVelocity, ZVCFRETorque, REPCGain,...
    REInputA,REAf,REInputD, REInputE, REInputF, REInputG, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    JointTorqueRE=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % RE Joint Rotational Deltas
    DeltaREPosition=REPosition-TargetREPosition;
    DeltaREVelocity=REVelocity-TargetREVelocity;
    % Control Based Strategy
    JointTorqueRE=DeltaREPosition*REPCGain*GlobalPCGain-DeltaREVelocity*REVCGain*GlobalVCGain-DampeningGlobalGain*REDampening*(1-LocalDampeningEnable)*REVelocity;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    JointTorqueRE=Killswitch*GlobalGain*(REConstant+RETimeGain*Time-REPositionGain*(REPosition-REPositionSetpoint)...
    -REDampening*REVelocity);
elseif ModelingMode==3
    JointTorqueRE=HexPolyInputFunction(REInputA,REInputB,REInputC,REInputD,REInputE,REInputF,REInputG,Time)*Killswitch;
else
    %ZVCF Based Joint Torques. Values are pulled from model workspace and
    %held constant.
    JointTorqueRE=ZVCFRETorque;
end

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Manual Set Option
% KinematicMode=3;

if KinematicMode==0
    % All kinematic values set to zero.
    REPositionInput=0;
    REVelocityInput=0;
    REAccelerationInput=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetREPosition;       
    VTX=TargetREVelocity;
    % Define Starting Position and Velocity
    PIX=REStartPosition;
    VIX=REStartVelocity;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    % Equation for position as a function of time
    REPositionInput=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    REVelocityInput=AX*Time^2+BX*Time+CX;
    REAccelerationInput=2*AX*Time+BX;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=REStartPosition;
    VoX=REStartVelocity;
    PfX=TargetREPosition;
    VfX=TargetREVelocity;
    AoX=REAo;
    REPositionInput=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    REVelocityInput=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    REAccelerationInput=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=REStartPosition;
    VoX=REStartVelocity;
    PfX=TargetREPosition;
    VfX=TargetREVelocity;
    AoX=REAo;
    AfX=REAf;
    REPositionInput=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    REVelocityInput=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    REAccelerationInput=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
end

% Calculate Higher Order Derivatives of the Position Outputs
REJerk=gradient(REAccelerationInput,t);
RESnap=gradient(REJerk,t);
RECrackle=gradient(RESnap,t);
REPop=gradient(RECrackle,t);</P>
      </eml>
    </state>
    <data SSID="4" name="Time">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
