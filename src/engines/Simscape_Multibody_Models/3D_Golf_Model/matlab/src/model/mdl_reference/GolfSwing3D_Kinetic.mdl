        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="LScapInputXB">
      <P Name="scope">PARAMETER_DATA</P>
      <P Name="paramIndexForInitFromWorkspace">14</P>
      <props>
        <array>
          <P Name="size">-1</P>
