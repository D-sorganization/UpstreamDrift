__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_519.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="519">
  <P Name="name">RW Input Function/Right Wrist Torque</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">519</P>
  <P Name="ssIdHighWaterMark">83</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">10</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">519</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [JointTorqueRWX,JointTorqueRWY,RWPositionInputX, RWPositionInputY,...
    RWVelocityInputX,RWVelocityInputY,RWAccelerationInputX,RWAccelerationInputY,...
    RWJointTorqueInputGlobal,RWConstraintTorque]...
    = fcn(Time,Killswitch, RWInputXA,RWInputYA, RWInputXB,RWInputYB, RWPositionSetpointX,GlobalGain,...
    RWConstantX, RWConstantY, RWTimeGainX, RWTimeGainY,...
    RWInputXC, RWInputYC, RWPositionGainX, RWPositionGainY,...
    TargetRWPositionX, ModelingMode,GlobalPCGain, GlobalVCGain,...
    DampeningGlobalGain,TargetImpactTime,KinematicMode, RWVCGainY,...
    RWPCGainX, RWPCGainY, ZVCFRWTorqueX, ...
    ZVCFRWTorqueY, TargetRWPositionY, TargetRWVelocityX, TargetRWVelocityY,...
    RWAoX, RWAoY, RWDampeningX, RWDampeningY, RWPositionX, RWPositionY, RWStartPositionX,...
    RWStartPositionY, RWStartVelocityX, RWStartVelocityY, RWVCGainX,...
    RWPositionSetpointY, RWVelocityX, RWVelocityY,RWAfX, RWAfY,RWInputXD, RWInputXE, RWInputXF,...
RWInputXG, RWInputYD, RWInputYE, RWInputYF, RWInputYG,RWLocaltoGlobalR,RWTorqueGlobal, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    JointTorqueRWX=0;
    JointTorqueRWY=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % RW Joint Rotational Deltas
    DeltaRWPositionX=RWPositionX-TargetRWPositionX;
    DeltaRWPositionY=RWPositionY-TargetRWPositionY;
    DeltaRWVelocityX=RWVelocityX-TargetRWVelocityX;
    DeltaRWVelocityY=RWVelocityY-TargetRWVelocityY;
    % Control Based Strategy
    JointTorqueRWX=DeltaRWPositionX*RWPCGainX*GlobalPCGain-DeltaRWVelocityX*RWVCGainX*GlobalVCGain-DampeningGlobalGain*RWDampeningX*(1-LocalDampeningEnable)*RWVelocityX;
    JointTorqueRWY=DeltaRWPositionY*RWPCGainY*GlobalPCGain-DeltaRWVelocityY*RWVCGainY*GlobalVCGain-DampeningGlobalGain*RWDampeningY*(1-LocalDampeningEnable)*RWVelocityY;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    JointTorqueRWX=Killswitch*GlobalGain*(RWConstantX+RWTimeGainX*Time-RWPositionGainX*(RWPositionX-RWPositionSetpointX)...
    -RWDampeningX*RWVelocityX);
    JointTorqueRWY=Killswitch*GlobalGain*(RWConstantY+RWTimeGainY*Time-RWPositionGainY*(RWPositionY-RWPositionSetpointY)...
    -RWDampeningY*RWVelocityY);
elseif ModelingMode==3
    JointTorqueRWX=HexPolyInputFunction(RWInputXA,RWInputXB,RWInputXC,RWInputXD,RWInputXE,RWInputXF,RWInputXG,Time)*Killswitch;
    JointTorqueRWY=HexPolyInputFunction(RWInputYA,RWInputYB,RWInputYC,RWInputYD,RWInputYE,RWInputYF,RWInputYG,Time)*Killswitch;  
else
    %ZVCF Based Joint Torques. Values are pulled from model workspace and
    %held constant.
    JointTorqueRWX=ZVCFRWTorqueX;
    JointTorqueRWY=ZVCFRWTorqueY;
end

% Create a global vector of the joint torque inputs
RWJointTorqueInputLocal=cat(1,JointTorqueRWX,JointTorqueRWY,0);
RWJointTorqueInputGlobal=RWLocaltoGlobalR*RWJointTorqueInputLocal;

% Compare total torque measured to input torques applied to see the
% constraint torque

RWConstraintTorque=RWTorqueGlobal-RWJointTorqueInputGlobal;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if KinematicMode==0
    % All kinematic values set to zero.
    RWPositionInputX=0;
    RWPositionInputY=0;
    RWVelocityInputX=0;
    RWVelocityInputY=0;
    RWAccelerationInputX=0;
    RWAccelerationInputY=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetRWPositionX;       
    VTX=TargetRWVelocityX;
    PTY=TargetRWPositionY;
    VTY=TargetRWVelocityY;
    % Define Starting Position and Velocity
    PIX=RWStartPositionX;
    VIX=RWStartVelocityX;
    PIY=RWStartPositionY;
    VIY=RWStartVelocityY;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    AY=3*((VTY+VIY)*TargetImpactTime-2*(PTY-PIY))/TargetImpactTime^3;         % Constant in position equation
    BY=-2*((VTY+2*VIY)*TargetImpactTime-3*(PTY-PIY))/TargetImpactTime^2;         % Constant in position equation
    CY=VIY;         % Starting Velocity at Time Zero
    DY=PIY;         % Starting Position at Time Zero
    % Equation for position as a function of time
    RWPositionInputX=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    RWPositionInputY=AY*Time^3/3+BY*Time^2/2+CY*Time+DY;
    RWVelocityInputX=AX*Time^2+BX*Time+CX;
    RWVelocityInputY=AY*Time^2+BY*Time+CY;
    RWAccelerationInputX=2*AX*Time+BX;
    RWAccelerationInputY=2*AY*Time+BY;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=RWStartPositionX;
    PoY=RWStartPositionY;
    VoX=RWStartVelocityX;
    VoY=RWStartVelocityY;
    PfX=TargetRWPositionX;
    PfY=TargetRWPositionY;
    VfX=TargetRWVelocityX;
    VfY=TargetRWVelocityY;
    AoX=RWAoX;
    AoY=RWAoY;
    RWPositionInputX=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    RWPositionInputY=PoY + VoY*t + (AoY*t^2)/2 - (t^3*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (t^4*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/(2*Tt^4);
    RWVelocityInputX=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    RWVelocityInputY=VoY + AoY*t - (3*t^2*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (2*t^3*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4;
    RWAccelerationInputX=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
    RWAccelerationInputY=AoY + (6*t^2*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4 - (6*t*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=RWStartPositionX;
    PoY=RWStartPositionY;
    VoX=RWStartVelocityX;
    VoY=RWStartVelocityY;
    PfX=TargetRWPositionX;
    PfY=TargetRWPositionY;
    VfX=TargetRWVelocityX;
    VfY=TargetRWVelocityY;
    AoX=RWAoX;
    AoY=RWAoY;
    AfX=RWAfX;
    AfY=RWAfY;
    RWPositionInputX=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    RWPositionInputY=PoY+VoY*t+(AoY*t^2)/2-(t^5*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(t^3*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(t^4*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^4);  
    RWVelocityInputX=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    RWVelocityInputY=VoY+AoY*t-(5*t^4*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    RWAccelerationInputX=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    RWAccelerationInputY=AoY-(3*t*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/Tt^3-(10*t^3*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/Tt^5+(6*t^2*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
end

% Calculate Higher Order Derivatives of the Position Outputs
RWJerkX=gradient(RWAccelerationInputX,t);
RWJerkY=gradient(RWAccelerationInputY,t);
RWSnapX=gradient(RWJerkX,t);
RWSnapY=gradient(RWJerkY,t);
RWCrackleX=gradient(RWSnapX,t);
RWCrackleY=gradient(RWSnapY,t);
RWPopX=gradient(RWCrackleX,t);
RWPopY=gradient(RWCrackleY,t);
</P>
      </eml>
    </state>
