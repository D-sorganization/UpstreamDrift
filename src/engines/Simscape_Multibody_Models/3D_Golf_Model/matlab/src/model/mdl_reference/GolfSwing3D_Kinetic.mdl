__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_252.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="252">
  <P Name="name">Torso Input Function/Torso Input Torque</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">252</P>
  <P Name="ssIdHighWaterMark">110</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">4</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">252</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [JointTorqueTorso,TorsoPositionInput,TorsoVelocityInput,...
    TorsoAccelerationInput]  = fcn(Time,Killswitch,...
    TorsoInputB,TorsoPositionSetpoint,GlobalGain,...
    TorsoDampening, ModelingMode,GlobalPCGain, GlobalVCGain,...
    DampeningGlobalGain,TargetImpactTime,KinematicMode, TorsoAo,TorsoStartPosition,...
    TorsoStartVelocity,ZVCFTorsoTorque,TorsoPCGain,TorsoVCGain,...
    TargetTorsoVelocity,TargetTorsoPosition, ...
    TorsoPositionGain,TorsoInputC,...
    TorsoTimeGain, TorsoConstant,TorsoPosition,TorsoVelocity, TorsoInputA,TorsoAf,TorsoInputD, TorsoInputE, TorsoInputF, TorsoInputG, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    JointTorqueTorso=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % Torso Joint Rotational Deltas
    DeltaTorsoPosition=TorsoPosition-TargetTorsoPosition;
    DeltaTorsoVelocity=TorsoVelocity-TargetTorsoVelocity;
    % Control Based Strategy
    JointTorqueTorso=DeltaTorsoPosition*TorsoPCGain*GlobalPCGain-DeltaTorsoVelocity*TorsoVCGain*GlobalVCGain-DampeningGlobalGain*TorsoDampening*(1-LocalDampeningEnable)*TorsoVelocity;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    JointTorqueTorso=Killswitch*GlobalGain*(TorsoConstant+TorsoTimeGain*Time-TorsoPositionGain*(TorsoPosition-TorsoPositionSetpoint)...
    -TorsoDampening*TorsoVelocity);
elseif ModelingMode==3
    JointTorqueTorso=HexPolyInputFunction(TorsoInputA,TorsoInputB,TorsoInputC,TorsoInputD,TorsoInputE,TorsoInputF,TorsoInputG,Time)*Killswitch;
else
    %ZVCF Based Joint Torques. Values are pulled from model workspace and
    %held constant.
    JointTorqueTorso=ZVCFTorsoTorque;
end

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if KinematicMode==0
    % All kinematic values set to zero.
    TorsoPositionInput=0;
    TorsoPositionInputY=0;
    TorsoVelocityInput=0;
    TorsoVelocityInputY=0;
    TorsoAccelerationInput=0;
    TorsoAccelerationInputY=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetTorsoPosition;       
    VTX=TargetTorsoVelocity;
    % Define Starting Position and Velocity
    PIX=TorsoStartPosition;
    VIX=TorsoStartVelocity;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    % Equation for position as a function of time
    TorsoPositionInput=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    TorsoVelocityInput=AX*Time^2+BX*Time+CX;
    TorsoAccelerationInput=2*AX*Time+BX;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=TorsoStartPosition;
    VoX=TorsoStartVelocity;
    PfX=TargetTorsoPosition;
    VfX=TargetTorsoVelocity;
    AoX=TorsoAo;
    TorsoPositionInput=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    TorsoVelocityInput=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    TorsoAccelerationInput=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=TorsoStartPosition;
    VoX=TorsoStartVelocity;
    PfX=TargetTorsoPosition;
    VfX=TargetTorsoVelocity;
    AoX=TorsoAo;
    AfX=TorsoAf;
    TorsoPositionInput=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    TorsoVelocityInput=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    TorsoAccelerationInput=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
end


% Calculate Higher Order Derivatives of the Position Outputs
TorsoJerk=gradient(TorsoAccelerationInput,t);
TorsoSnap=gradient(TorsoJerk,t);
TorsoCrackle=gradient(TorsoSnap,t);
TorsoPop=gradient(TorsoCrackle,t);

</P>
      </eml>
    </state>
    <data SSID="4" name="Time">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="Killswitch">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="JointTorqueTorso">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="22" name="TorsoInputB">
      <P Name="scope">PARAMETER_DATA</P>
      <P Name="paramIndexForInitFromWorkspace">15</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
