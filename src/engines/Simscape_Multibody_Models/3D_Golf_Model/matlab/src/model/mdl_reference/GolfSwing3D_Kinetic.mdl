__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_212.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="212">
  <P Name="name">Club Calculations/Subsystem/Total Wrist Forces and Torques Local</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">212</P>
  <P Name="ssIdHighWaterMark">54</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">212</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [TotalHandTorqueLocal,TotalHandTorqueGlobal,ClubTorqueMagnitude,TotalHandForceLocal,TotalHandForceGlobal,...
    ClubForceMagnitude,HandForceYankLocal,ForceAlongHandPath,LinearPoweronClub,...
    LHonClubAngularPower,RHonClubAngularPower,SumofMomentsLHonClub,SumofMomentsRHonClub,...
    LHonClubLinearPower,RHonClubLinearPower,LHForceAlongHandPath,RHForceAlongHandPath] = ...
    fcn(LHTL,RHTL,LHTG,RHTG,LHFL,RHFL,LHFG,RHFG,HandPathVector,MidpointVelocity,LHAV,RHAV,LHMOF,RHMOF,...
    LHVelocity,RHVelocity,LHandPathVector,RHandPathVector)

% Local Torques
TotalHandTorqueLocal = LHTL+RHTL;
ClubTorqueMagnitude=norm(TotalHandTorqueLocal);

% Local Forces
TotalHandForceLocal = LHFL+RHFL;
ClubForceMagnitude=norm(TotalHandForceLocal);
HandForceYankLocal=diff(TotalHandForceLocal);

% Global Torques
TotalHandTorqueGlobal=LHTG+RHTG;

% Global Forces
TotalHandForceGlobal=LHFG+RHFG;

% Force Along Hand Path
ForceAlongHandPath=dot(TotalHandForceGlobal,HandPathVector);
LHForceAlongHandPath=dot(LHFG,LHandPathVector);
RHForceAlongHandPath=dot(RHFG,RHandPathVector);

% Linear Power Applied to Club
LinearPoweronClub=dot(TotalHandForceGlobal,MidpointVelocity);
LHonClubLinearPower=dot(LHFG,LHVelocity);
RHonClubLinearPower=dot(RHFG,RHVelocity);

% Angular Power
LHonClubAngularPower=dot(LHTG,LHAV);
RHonClubAngularPower=dot(RHTG,RHAV);

% Sum of Moments
SumofMomentsLHonClub=LHMOF+LHTG;
SumofMomentsRHonClub=RHMOF+RHTG;



</P>
      </eml>
    </state>
    <data SSID="4" name="LHTL">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
