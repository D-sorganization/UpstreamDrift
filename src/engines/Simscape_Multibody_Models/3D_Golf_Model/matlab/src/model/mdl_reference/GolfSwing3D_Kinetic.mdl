__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_880.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="880">
  <P Name="name">LS Input Function/Left Shoulder Torque Output</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">880</P>
  <P Name="ssIdHighWaterMark">114</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">18</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">880</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [JointTorqueLSX,JointTorqueLSY,JointTorqueLSZ,LSPositionInputX,LSPositionInputY,LSPositionInputZ,LSVelocityInputX,...
    LSVelocityInputY, LSVelocityInputZ,LSAccelerationInputX,LSAccelerationInputY,LSAccelerationInputZ] = fcn(Time,Killswitch, LSInputXA,LSInputYA,LSInputZA, LSInputXB,LSInputYB,LSInputZB, LSPositionSetpointX,LSPositionSetpointY,GlobalGain,...
    LSDampeningX, LSDampeningY, LSDampeningZ, LSConstantX, LSConstantY, LSConstantZ, LSTimeGainX, LSPositionGainY, LSPositionGainZ, LSPositionSetpointZ,...
    TargetLSPositionX, TargetLSPositionY, TargetLSPositionZ, TargetLSVelocityX, TargetLSVelocityY, TargetLSVelocityZ,LSPCGainX, LSPCGainY, LSPCGainZ, LSVCGainX,...
    LSVCGainY, LSVCGainZ,ModelingMode,ZVCFLSTorqueX, ZVCFLSTorqueY, ZVCFLSTorqueZ,GlobalPCGain, GlobalVCGain,DampeningGlobalGain,TargetImpactTime,LSStartPositionX,...
    LSStartPositionY, LSStartPositionZ, LSStartVelocityX, LSStartVelocityY, LSStartVelocityZ,LSAoX, LSAoY, LSAoZ, KinematicMode, LSInputYC, LSInputXC, LSInputZC,...
    LSTimeGainY, LSTimeGainZ, LSPositionX, LSPositionY, LSPositionZ, LSVelocityX, LSVelocityY,LSVelocityZ,...
    LSPositionGainX, LSAfX, LSAfY, LSAfZ,LSInputXD, LSInputXE, LSInputXF, LSInputXG,...
LSInputYD, LSInputYE, LSInputYF, LSInputYG, LSInputZD, LSInputZE, LSInputZF, LSInputZG, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    JointTorqueLSX=0;
    JointTorqueLSY=0;
    JointTorqueLSZ=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % LS Joint Rotational Deltas
    DeltaLSPositionX=LSPositionX-TargetLSPositionX;
    DeltaLSPositionY=LSPositionY-TargetLSPositionY;
    DeltaLSPositionZ=LSPositionZ-TargetLSPositionZ;
    DeltaLSVelocityX=LSVelocityX-TargetLSVelocityX;
    DeltaLSVelocityY=LSVelocityY-TargetLSVelocityY;
    DeltaLSVelocityZ=LSVelocityZ-TargetLSVelocityZ;
    % Control Based Strategy
    JointTorqueLSX=DeltaLSPositionX*LSPCGainX*GlobalPCGain-DeltaLSVelocityX*LSVCGainX*GlobalVCGain-DampeningGlobalGain*LSDampeningX*(1-LocalDampeningEnable)*LSVelocityX;
    JointTorqueLSY=DeltaLSPositionY*LSPCGainY*GlobalPCGain-DeltaLSVelocityY*LSVCGainY*GlobalVCGain-DampeningGlobalGain*LSDampeningY*(1-LocalDampeningEnable)*LSVelocityY;
    JointTorqueLSZ=DeltaLSPositionZ*LSPCGainZ*GlobalPCGain-DeltaLSVelocityZ*LSVCGainZ*GlobalVCGain-DampeningGlobalGain*LSDampeningZ*(1-LocalDampeningEnable)*LSVelocityZ;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    JointTorqueLSX=Killswitch*GlobalGain*(LSConstantX+LSTimeGainX*Time-LSPositionGainX*(LSPositionX-LSPositionSetpointX)...
    -LSDampeningX*LSVelocityX);
    JointTorqueLSY=Killswitch*GlobalGain*(LSConstantY+LSTimeGainY*Time-LSPositionGainY*(LSPositionY-LSPositionSetpointY)...
    -LSDampeningY*LSVelocityY);
    JointTorqueLSZ=Killswitch*GlobalGain*(LSConstantZ+LSTimeGainZ*Time-LSPositionGainZ*(LSPositionZ-LSPositionSetpointZ)...
    -LSDampeningZ*LSVelocityZ);
elseif ModelingMode==3
    JointTorqueLSX=HexPolyInputFunction(LSInputXA,LSInputXB,LSInputXC,LSInputXD,LSInputXE,LSInputXF,LSInputXG,Time)*Killswitch;
    JointTorqueLSY=HexPolyInputFunction(LSInputYA,LSInputYB,LSInputYC,LSInputYD,LSInputYE,LSInputYF,LSInputYG,Time)*Killswitch;
    JointTorqueLSZ=HexPolyInputFunction(LSInputZA,LSInputZB,LSInputZC,LSInputZD,LSInputZE,LSInputZF,LSInputZG,Time)*Killswitch;
else
    %ZVCF Based Joint Torques. Values are pulled from model workspace and
    %held constant.
    JointTorqueLSX=ZVCFLSTorqueX;
    JointTorqueLSY=ZVCFLSTorqueY;
    JointTorqueLSZ=ZVCFLSTorqueZ;
end

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if KinematicMode==0
    % All kinematic values set to zero.
    LSPositionInputX=0;
    LSPositionInputY=0;
    LSPositionInputZ=0;
    LSVelocityInputX=0;
    LSVelocityInputY=0;
    LSVelocityInputZ=0;
    LSAccelerationInputX=0;
    LSAccelerationInputY=0;
    LSAccelerationInputZ=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetLSPositionX;       
    VTX=TargetLSVelocityX;
    PTY=TargetLSPositionY;
    VTY=TargetLSVelocityY;
    PTZ=TargetLSPositionZ;
    VTZ=TargetLSVelocityZ;
    % Define Starting Position and Velocity
    PIX=LSStartPositionX;
    VIX=LSStartVelocityX;
    PIY=LSStartPositionY;
    VIY=LSStartVelocityY;
    PIZ=LSStartPositionZ;
    VIZ=LSStartVelocityZ;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    AY=3*((VTY+VIY)*TargetImpactTime-2*(PTY-PIY))/TargetImpactTime^3;         % Constant in position equation
    BY=-2*((VTY+2*VIY)*TargetImpactTime-3*(PTY-PIY))/TargetImpactTime^2;         % Constant in position equation
    CY=VIY;         % Starting Velocity at Time Zero
    DY=PIY;         % Starting Position at Time Zero
    AZ=3*((VTZ+VIZ)*TargetImpactTime-2*(PTZ-PIZ))/TargetImpactTime^3;         % Constant in position equation
    BZ=-2*((VTZ+2*VIZ)*TargetImpactTime-3*(PTZ-PIZ))/TargetImpactTime^2;         % Constant in position equation
    CZ=VIZ;         % Starting Velocity at Time Zero
    DZ=PIZ;         % Starting Position at Time Zero
    % Equation for position as a function of time
    LSPositionInputX=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    LSPositionInputY=AY*Time^3/3+BY*Time^2/2+CY*Time+DY;
    LSPositionInputZ=AZ*Time^3/3+BZ*Time^2/2+CZ*Time+DZ;
    LSVelocityInputX=AX*Time^2+BX*Time+CX;
    LSVelocityInputY=AY*Time^2+BY*Time+CY;
    LSVelocityInputZ=AZ*Time^2+BZ*Time+CZ;
    LSAccelerationInputX=2*AX*Time+BX;
    LSAccelerationInputY=2*AY*Time+BY;
    LSAccelerationInputZ=2*AZ*Time+BZ;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=LSStartPositionX;
    PoY=LSStartPositionY;
    PoZ=LSStartPositionZ;
    VoX=LSStartVelocityX;
    VoY=LSStartVelocityY;
    VoZ=LSStartVelocityZ;
    PfX=TargetLSPositionX;
    PfY=TargetLSPositionY;
    PfZ=TargetLSPositionZ;
    VfX=TargetLSVelocityX;
    VfY=TargetLSVelocityY;
    VfZ=TargetLSVelocityZ;
    AoX=LSAoX;
    AoY=LSAoY;
    AoZ=LSAoZ;
    LSPositionInputX=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    LSPositionInputY=PoY + VoY*t + (AoY*t^2)/2 - (t^3*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (t^4*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/(2*Tt^4);
    LSPositionInputZ=PoZ + VoZ*t + (AoZ*t^2)/2 - (t^3*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3 + (t^4*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/(2*Tt^4);
    LSVelocityInputX=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    LSVelocityInputY=VoY + AoY*t - (3*t^2*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (2*t^3*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4;
    LSVelocityInputZ=VoZ + AoZ*t - (3*t^2*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3 + (2*t^3*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/Tt^4;
    LSAccelerationInputX=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
    LSAccelerationInputY=AoY + (6*t^2*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4 - (6*t*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3;
    LSAccelerationInputZ=AoZ + (6*t^2*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/Tt^4 - (6*t*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=LSStartPositionX;
    PoY=LSStartPositionY;
    PoZ=LSStartPositionZ;
    VoX=LSStartVelocityX;
    VoY=LSStartVelocityY;
    VoZ=LSStartVelocityZ;
    PfX=TargetLSPositionX;
    PfY=TargetLSPositionY;
    PfZ=TargetLSPositionZ;
    VfX=TargetLSVelocityX;
    VfY=TargetLSVelocityY;
    VfZ=TargetLSVelocityZ;
    AoX=LSAoX;
    AoY=LSAoY;
    AoZ=LSAoZ;
    AfX=LSAfX;
    AfY=LSAfY;
    AfZ=LSAfZ;
    LSPositionInputX=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    LSPositionInputY=PoY+VoY*t+(AoY*t^2)/2-(t^5*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(t^3*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(t^4*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^4);  
    LSPositionInputZ=PoZ+VoZ*t+(AoZ*t^2)/2-(t^5*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/(2*Tt^5)-(t^3*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^3)+(t^4*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^4);
    LSVelocityInputX=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    LSVelocityInputY=VoY+AoY*t-(5*t^4*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    LSVelocityInputZ=VoZ+AoZ*t-(5*t^4*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/Tt^4;
    LSAccelerationInputX=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    LSAccelerationInputY=AoY-(3*t*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/Tt^3-(10*t^3*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/Tt^5+(6*t^2*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    LSAccelerationInputZ=AoZ-(3*t*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/Tt^3-(10*t^3*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/Tt^5+(6*t^2*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/Tt^4;
end


% Calculate Higher Order Derivatives of the Position Outputs
LSJerkX=gradient(LSAccelerationInputX,t);
LSJerkY=gradient(LSAccelerationInputY,t);
LSJerkZ=gradient(LSAccelerationInputZ,t);
LSSnapX=gradient(LSJerkX,t);
LSSnapY=gradient(LSJerkY,t);
LSSnapZ=gradient(LSJerkZ,t);
LSCrackleX=gradient(LSSnapX,t);
LSCrackleY=gradient(LSSnapY,t);
LSCrackleZ=gradient(LSSnapZ,t);
LSPopX=gradient(LSCrackleX,t);
LSPopY=gradient(LSCrackleY,t);
LSPopZ=gradient(LSCrackleZ,t);
</P>
      </eml>
    </state>
    <data SSID="13" name="Time">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
