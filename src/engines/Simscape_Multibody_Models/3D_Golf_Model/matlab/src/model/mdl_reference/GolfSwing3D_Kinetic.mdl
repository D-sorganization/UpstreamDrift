__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_294.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="294">
  <P Name="name">LScap Input Function/LScap Torque</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">294</P>
  <P Name="ssIdHighWaterMark">84</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">5</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">294</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [JointTorqueLScapX,JointTorqueLScapY,LScapPositionInputX, LScapPositionInputY, LScapVelocityInputX,LScapVelocityInputY,LScapAccelerationInputX,LScapAccelerationInputY] = fcn(Time,Killswitch, LScapInputXA,LScapInputYA, LScapInputXB,LScapInputYB, LScapPositionSetpointX,GlobalGain,...
    LScapConstantX, LScapConstantY, LScapTimeGainX, LScapTimeGainY,...
    LScapInputXC, LScapInputYC, LScapPositionGainX, LScapPositionGainY,...
    TargetLScapPositionX, ModelingMode,GlobalPCGain, GlobalVCGain,DampeningGlobalGain,TargetImpactTime,LScapAoX, LScapAoY, KinematicMode, LScapDampeningX, LScapDampeningY, LScapPositionSetpointY, LScapStartPositionX,...
    LScapStartPositionY, LScapStartVelocityX, LScapStartVelocityY, LScapVCGainX,...
    LScapVCGainY, LScapPCGainX, LScapPCGainY, LScapPositionX, LScapPositionY, LScapVelocityX,...
    LScapVelocityY, ZVCFLScapTorqueX, ZVCFLScapTorqueY, TargetLScapPositionY, TargetLScapVelocityX,...
    TargetLScapVelocityY,LScapAfX, LScapAfY,LScapInputXD, LScapInputXE, LScapInputXF, LScapInputXG,...
LScapInputYD, LScapInputYE, LScapInputYF, LScapInputYG, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    JointTorqueLScapX=0;
    JointTorqueLScapY=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % LScap Joint Rotational Deltas
    DeltaLScapPositionX=LScapPositionX-TargetLScapPositionX;
    DeltaLScapPositionY=LScapPositionY-TargetLScapPositionY;
    DeltaLScapVelocityX=LScapVelocityX-TargetLScapVelocityX;
    DeltaLScapVelocityY=LScapVelocityY-TargetLScapVelocityY;
    % Control Based Strategy
    JointTorqueLScapX=DeltaLScapPositionX*LScapPCGainX*GlobalPCGain-DeltaLScapVelocityX*LScapVCGainX*GlobalVCGain-DampeningGlobalGain*LScapDampeningX*(1-LocalDampeningEnable)*LScapVelocityX;
    JointTorqueLScapY=DeltaLScapPositionY*LScapPCGainY*GlobalPCGain-DeltaLScapVelocityY*LScapVCGainY*GlobalVCGain-DampeningGlobalGain*LScapDampeningY*(1-LocalDampeningEnable)*LScapVelocityY;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    JointTorqueLScapX=Killswitch*GlobalGain*(LScapConstantX+LScapTimeGainX*Time-LScapPositionGainX*(LScapPositionX-LScapPositionSetpointX)...
    -LScapDampeningX*LScapVelocityX);
    JointTorqueLScapY=Killswitch*GlobalGain*(LScapConstantY+LScapTimeGainY*Time-LScapPositionGainY*(LScapPositionY-LScapPositionSetpointY)...
    -LScapDampeningY*LScapVelocityY);
elseif ModelingMode==3
    JointTorqueLScapX=HexPolyInputFunction(LScapInputXA,LScapInputXB,LScapInputXC,LScapInputXD,LScapInputXE,LScapInputXF,LScapInputXG,Time)*Killswitch;
    JointTorqueLScapY=HexPolyInputFunction(LScapInputYA,LScapInputYB,LScapInputYC,LScapInputYD,LScapInputYE,LScapInputYF,LScapInputYG,Time)*Killswitch; 
else
    %ZVCF Based Joint Torques. Values are pulled from model workspace and
    %held constant.
    JointTorqueLScapX=ZVCFLScapTorqueX;
    JointTorqueLScapY=ZVCFLScapTorqueY;
end

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if KinematicMode==0
    % All kinematic values set to zero.
    LScapPositionInputX=0;
    LScapPositionInputY=0;
    LScapVelocityInputX=0;
    LScapVelocityInputY=0;
    LScapAccelerationInputX=0;
    LScapAccelerationInputY=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetLScapPositionX;       
    VTX=TargetLScapVelocityX;
    PTY=TargetLScapPositionY;
    VTY=TargetLScapVelocityY;
    % Define Starting Position and Velocity
    PIX=LScapStartPositionX;
    VIX=LScapStartVelocityX;
    PIY=LScapStartPositionY;
    VIY=LScapStartVelocityY;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    AY=3*((VTY+VIY)*TargetImpactTime-2*(PTY-PIY))/TargetImpactTime^3;         % Constant in position equation
    BY=-2*((VTY+2*VIY)*TargetImpactTime-3*(PTY-PIY))/TargetImpactTime^2;         % Constant in position equation
    CY=VIY;         % Starting Velocity at Time Zero
    DY=PIY;         % Starting Position at Time Zero
    % Equation for position as a function of time
    LScapPositionInputX=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    LScapPositionInputY=AY*Time^3/3+BY*Time^2/2+CY*Time+DY;
    LScapVelocityInputX=AX*Time^2+BX*Time+CX;
    LScapVelocityInputY=AY*Time^2+BY*Time+CY;
    LScapAccelerationInputX=2*AX*Time+BX;
    LScapAccelerationInputY=2*AY*Time+BY;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=LScapStartPositionX;
    PoY=LScapStartPositionY;
    VoX=LScapStartVelocityX;
    VoY=LScapStartVelocityY;
    PfX=TargetLScapPositionX;
    PfY=TargetLScapPositionY;
    VfX=TargetLScapVelocityX;
    VfY=TargetLScapVelocityY;
    AoX=LScapAoX;
    AoY=LScapAoY;
    LScapPositionInputX=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    LScapPositionInputY=PoY + VoY*t + (AoY*t^2)/2 - (t^3*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (t^4*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/(2*Tt^4);
    LScapVelocityInputX=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    LScapVelocityInputY=VoY + AoY*t - (3*t^2*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (2*t^3*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4;
    LScapAccelerationInputX=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
    LScapAccelerationInputY=AoY + (6*t^2*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4 - (6*t*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=LScapStartPositionX;
    PoY=LScapStartPositionY;
    VoX=LScapStartVelocityX;
    VoY=LScapStartVelocityY;
    PfX=TargetLScapPositionX;
    PfY=TargetLScapPositionY;
    VfX=TargetLScapVelocityX;
    VfY=TargetLScapVelocityY;
    AoX=LScapAoX;
    AoY=LScapAoY;
    AfX=LScapAfX;
    AfY=LScapAfY;
    LScapPositionInputX=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    LScapPositionInputY=PoY+VoY*t+(AoY*t^2)/2-(t^5*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(t^3*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(t^4*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^4);  
    LScapVelocityInputX=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    LScapVelocityInputY=VoY+AoY*t-(5*t^4*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    LScapAccelerationInputX=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    LScapAccelerationInputY=AoY-(3*t*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/Tt^3-(10*t^3*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/Tt^5+(6*t^2*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
end

% Calculate Higher Order Derivatives of the Position Outputs
LScapJerkX=gradient(LScapAccelerationInputX,t);
LScapJerkY=gradient(LScapAccelerationInputY,t);
LScapSnapX=gradient(LScapJerkX,t);
LScapSnapY=gradient(LScapJerkY,t);
LScapCrackleX=gradient(LScapSnapX,t);
LScapCrackleY=gradient(LScapSnapY,t);
LScapPopX=gradient(LScapCrackleX,t);
LScapPopY=gradient(LScapCrackleY,t);</P>
      </eml>
    </state>
    <data SSID="4" name="Time">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="Killswitch">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="JointTorqueLScapX">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="LScapInputXA">
      <P Name="scope">PARAMETER_DATA</P>
      <P Name="paramIndexForInitFromWorkspace">13</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
