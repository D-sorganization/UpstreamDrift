  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">1072</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [JointTorqueSpineX,JointTorqueSpineY,SpinePositionInputX,SpinePositionInputY,SpineVelocityInputX,...
    SpineVelocityInputY,SpineAccelerationInputX,SpineAccelerationInputY] = fcn(Time,Killswitch, SpineInputXA,SpineInputYA, SpineInputXB,SpineInputYB, SpinePositionSetpointX,GlobalGain,...
    SpineConstantX, SpineConstantY, SpineTimeGainX, SpineTimeGainY,...
    SpineInputXC, SpineInputYC, SpinePositionGainX, SpinePositionGainY,...
    TargetSpinePositionX, TargetSpinePositionY,TargetSpineVelocityX, ModelingMode,GlobalPCGain, GlobalVCGain,DampeningGlobalGain,TargetImpactTime,SpinePCGainX, SpinePCGainY, SpineAoX, SpineAoY, KinematicMode, SpineDampeningX, SpineDampeningY, SpinePositionSetpointY, SpineStartPositionX,...
    SpineStartPositionY, SpineStartVelocityX, SpineStartVelocityY, SpineVCGainX,...
    SpineVCGainY, SpinePositionX, SpinePositionY,SpineVelocityX, SpineVelocityY,...
    TargetSpineVelocityY, ZVCFSpineTorqueX, ZVCFSpineTorqueY,SpineAfX, SpineAfY,...
     SpineInputXD, SpineInputXE, SpineInputXF, SpineInputXG, SpineInputYD, SpineInputYE, SpineInputYF, SpineInputYG, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    JointTorqueSpineX=0;
    JointTorqueSpineY=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % Spine Joint Rotational Deltas
    DeltaSpinePositionX=SpinePositionX-TargetSpinePositionX;
    DeltaSpinePositionY=SpinePositionY-TargetSpinePositionY;
    DeltaSpineVelocityX=SpineVelocityX-TargetSpineVelocityX;
    DeltaSpineVelocityY=SpineVelocityY-TargetSpineVelocityY;
    % Control Based Strategy
    JointTorqueSpineX=DeltaSpinePositionX*SpinePCGainX*GlobalPCGain-DeltaSpineVelocityX*SpineVCGainX*GlobalVCGain-DampeningGlobalGain*SpineDampeningX*(1-LocalDampeningEnable)*SpineVelocityX;
    JointTorqueSpineY=DeltaSpinePositionY*SpinePCGainY*GlobalPCGain-DeltaSpineVelocityY*SpineVCGainY*GlobalVCGain-DampeningGlobalGain*SpineDampeningY*(1-LocalDampeningEnable)*SpineVelocityY;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    JointTorqueSpineX=Killswitch*GlobalGain*(SpineConstantX+SpineTimeGainX*Time-SpinePositionGainX*(SpinePositionX-SpinePositionSetpointX)...
    -SpineDampeningX*SpineVelocityX);
    JointTorqueSpineY=Killswitch*GlobalGain*(SpineConstantY+SpineTimeGainY*Time-SpinePositionGainY*(SpinePositionY-SpinePositionSetpointY)...
    -SpineDampeningY*SpineVelocityY);
elseif ModelingMode==3
    JointTorqueSpineX=HexPolyInputFunction(SpineInputXA,SpineInputXB,SpineInputXC,SpineInputXD,SpineInputXE,SpineInputXF,SpineInputXG,Time)*Killswitch;
    JointTorqueSpineY=HexPolyInputFunction(SpineInputYA,SpineInputYB,SpineInputYC,SpineInputYD,SpineInputYE,SpineInputYF,SpineInputYG,Time)*Killswitch;
else
    %ZVCF Based Joint Torques. Values are pulled from model workspace and
    %held constant.
    JointTorqueSpineX=ZVCFSpineTorqueX;
    JointTorqueSpineY=ZVCFSpineTorqueY;
end

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if KinematicMode==0
    % All kinematic values set to zero.
    SpinePositionInputX=0;
    SpinePositionInputY=0;
    SpineVelocityInputX=0;
    SpineVelocityInputY=0;
    SpineAccelerationInputX=0;
    SpineAccelerationInputY=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetSpinePositionX;       
    VTX=TargetSpineVelocityX;
    PTY=TargetSpinePositionY;
    VTY=TargetSpineVelocityY;
    % Define Starting Position and Velocity
    PIX=SpineStartPositionX;
    VIX=SpineStartVelocityX;
    PIY=SpineStartPositionY;
    VIY=SpineStartVelocityY;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    AY=3*((VTY+VIY)*TargetImpactTime-2*(PTY-PIY))/TargetImpactTime^3;         % Constant in position equation
    BY=-2*((VTY+2*VIY)*TargetImpactTime-3*(PTY-PIY))/TargetImpactTime^2;         % Constant in position equation
    CY=VIY;         % Starting Velocity at Time Zero
    DY=PIY;         % Starting Position at Time Zero
    % Equation for position as a function of time
    SpinePositionInputX=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    SpinePositionInputY=AY*Time^3/3+BY*Time^2/2+CY*Time+DY;
    SpineVelocityInputX=AX*Time^2+BX*Time+CX;
    SpineVelocityInputY=AY*Time^2+BY*Time+CY;
    SpineAccelerationInputX=2*AX*Time+BX;
    SpineAccelerationInputY=2*AY*Time+BY;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=SpineStartPositionX;
    PoY=SpineStartPositionY;
    VoX=SpineStartVelocityX;
    VoY=SpineStartVelocityY;
    PfX=TargetSpinePositionX;
    PfY=TargetSpinePositionY;
    VfX=TargetSpineVelocityX;
    VfY=TargetSpineVelocityY;
    AoX=SpineAoX;
    AoY=SpineAoY;
    SpinePositionInputX=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    SpinePositionInputY=PoY + VoY*t + (AoY*t^2)/2 - (t^3*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (t^4*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/(2*Tt^4);
    SpineVelocityInputX=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    SpineVelocityInputY=VoY + AoY*t - (3*t^2*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (2*t^3*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4;
    SpineAccelerationInputX=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
    SpineAccelerationInputY=AoY + (6*t^2*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4 - (6*t*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=SpineStartPositionX;
    PoY=SpineStartPositionY;
    VoX=SpineStartVelocityX;
    VoY=SpineStartVelocityY;
    PfX=TargetSpinePositionX;
    PfY=TargetSpinePositionY;
    VfX=TargetSpineVelocityX;
    VfY=TargetSpineVelocityY;
    AoX=SpineAoX;
    AoY=SpineAoY;
    AfX=SpineAfX;
    AfY=SpineAfY;
    SpinePositionInputX=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    SpinePositionInputY=PoY+VoY*t+(AoY*t^2)/2-(t^5*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(t^3*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(t^4*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^4);  
    SpineVelocityInputX=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    SpineVelocityInputY=VoY+AoY*t-(5*t^4*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    SpineAccelerationInputX=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    SpineAccelerationInputY=AoY-(3*t*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/Tt^3-(10*t^3*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/Tt^5+(6*t^2*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
end


% Calculate Higher Order Derivatives of the Position Outputs
SpineJerkX=gradient(SpineAccelerationInputX,t);
SpineJerkY=gradient(SpineAccelerationInputY,t);
SpineSnapX=gradient(SpineJerkX,t);
SpineSnapY=gradient(SpineJerkY,t);
SpineCrackleX=gradient(SpineSnapX,t);
SpineCrackleY=gradient(SpineSnapY,t);
SpinePopX=gradient(SpineCrackleX,t);
SpinePopY=gradient(SpineCrackleY,t);
</P>
      </eml>
    </state>
    <data SSID="4" name="Time">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="Killswitch">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
