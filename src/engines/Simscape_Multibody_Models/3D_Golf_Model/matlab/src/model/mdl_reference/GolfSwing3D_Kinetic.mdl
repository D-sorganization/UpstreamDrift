__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_363.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="363">
  <P Name="name">RScap Input Function/RScap Torque</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">363</P>
  <P Name="ssIdHighWaterMark">74</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">6</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">363</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [JointTorqueRScapX,JointTorqueRScapY,RScapPositionInputX,...
    RScapPositionInputY, RScapVelocityInputX,RScapVelocityInputY,...
    RScapAccelerationInputX,RScapAccelerationInputY] = fcn(Time,Killswitch,...
    RScapInputXA,RScapInputYA, RScapInputXB,RScapInputYB, RScapPositionSetpointX,GlobalGain,...
    RScapConstantX, RScapConstantY, RScapTimeGainX, RScapTimeGainY,...
    RScapInputXC, RScapInputYC, RScapPositionGainX, RScapPositionGainY,...
    TargetRScapPositionX, ModelingMode,GlobalPCGain, GlobalVCGain,DampeningGlobalGain,...
    TargetImpactTime,KinematicMode, RScapPositionSetpointY, RScapStartPositionX,...
    RScapStartPositionY, RScapVCGainX,RScapVCGainY, RScapPCGainX, RScapPCGainY,...
    ZVCFRScapTorqueX, ZVCFRScapTorqueY, ...
    TargetRScapPositionY, TargetRScapVelocityX, TargetRScapVelocityY,...
    RScapAoX, RScapAoY, RScapDampeningX, RScapDampeningY, RScapPositionX,...
    RScapPositionY, RScapVelocityX, RScapVelocityY, RScapStartVelocityX, RScapStartVelocityY,...
    RScapAfX, RScapAfY,RScapInputXD, RScapInputXE, RScapInputXF, RScapInputXG,...
RScapInputYD, RScapInputYE, RScapInputYF, RScapInputYG, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    JointTorqueRScapX=0;
    JointTorqueRScapY=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % RScap Joint Rotational Deltas
    DeltaRScapPositionX=RScapPositionX-TargetRScapPositionX;
    DeltaRScapPositionY=RScapPositionY-TargetRScapPositionY;
    DeltaRScapVelocityX=RScapVelocityX-TargetRScapVelocityX;
    DeltaRScapVelocityY=RScapVelocityY-TargetRScapVelocityY;
    % Control Based Strategy
    JointTorqueRScapX=DeltaRScapPositionX*RScapPCGainX*GlobalPCGain-DeltaRScapVelocityX*RScapVCGainX*GlobalVCGain-DampeningGlobalGain*RScapDampeningX*(1-LocalDampeningEnable)*RScapVelocityX;
    JointTorqueRScapY=DeltaRScapPositionY*RScapPCGainY*GlobalPCGain-DeltaRScapVelocityY*RScapVCGainY*GlobalVCGain-DampeningGlobalGain*RScapDampeningY*(1-LocalDampeningEnable)*RScapVelocityY;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    JointTorqueRScapX=Killswitch*GlobalGain*(RScapConstantX+RScapTimeGainX*Time-RScapPositionGainX*(RScapPositionX-RScapPositionSetpointX)...
    -RScapDampeningX*RScapVelocityX);
    JointTorqueRScapY=Killswitch*GlobalGain*(RScapConstantY+RScapTimeGainY*Time-RScapPositionGainY*(RScapPositionY-RScapPositionSetpointY)...
    -RScapDampeningY*RScapVelocityY);
elseif ModelingMode==3
    JointTorqueRScapX=HexPolyInputFunction(RScapInputXA,RScapInputXB,RScapInputXC,RScapInputXD,RScapInputXE,RScapInputXF,RScapInputXG,Time)*Killswitch;
    JointTorqueRScapY=HexPolyInputFunction(RScapInputYA,RScapInputYB,RScapInputYC,RScapInputYD,RScapInputYE,RScapInputYF,RScapInputYG,Time)*Killswitch;  
else
    %ZVCF Based Joint Torques. Values are pulled from model workspace and
    %held constant.
    JointTorqueRScapX=ZVCFRScapTorqueX;
    JointTorqueRScapY=ZVCFRScapTorqueY;
end

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if KinematicMode==0
    % All kinematic values set to zero.
    RScapPositionInputX=0;
    RScapPositionInputY=0;
    RScapVelocityInputX=0;
    RScapVelocityInputY=0;
    RScapAccelerationInputX=0;
    RScapAccelerationInputY=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetRScapPositionX;       
    VTX=TargetRScapVelocityX;
    PTY=TargetRScapPositionY;
    VTY=TargetRScapVelocityY;
    % Define Starting Position and Velocity
    PIX=RScapStartPositionX;
    VIX=RScapStartVelocityX;
    PIY=RScapStartPositionY;
    VIY=RScapStartVelocityY;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    AY=3*((VTY+VIY)*TargetImpactTime-2*(PTY-PIY))/TargetImpactTime^3;         % Constant in position equation
    BY=-2*((VTY+2*VIY)*TargetImpactTime-3*(PTY-PIY))/TargetImpactTime^2;         % Constant in position equation
    CY=VIY;         % Starting Velocity at Time Zero
    DY=PIY;         % Starting Position at Time Zero
    % Equation for position as a function of time
    RScapPositionInputX=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    RScapPositionInputY=AY*Time^3/3+BY*Time^2/2+CY*Time+DY;
    RScapVelocityInputX=AX*Time^2+BX*Time+CX;
    RScapVelocityInputY=AY*Time^2+BY*Time+CY;
    RScapAccelerationInputX=2*AX*Time+BX;
    RScapAccelerationInputY=2*AY*Time+BY;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=RScapStartPositionX;
    PoY=RScapStartPositionY;
    VoX=RScapStartVelocityX;
    VoY=RScapStartVelocityY;
    PfX=TargetRScapPositionX;
    PfY=TargetRScapPositionY;
    VfX=TargetRScapVelocityX;
    VfY=TargetRScapVelocityY;
    AoX=RScapAoX;
    AoY=RScapAoY;
    RScapPositionInputX=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    RScapPositionInputY=PoY + VoY*t + (AoY*t^2)/2 - (t^3*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (t^4*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/(2*Tt^4);
    RScapVelocityInputX=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    RScapVelocityInputY=VoY + AoY*t - (3*t^2*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (2*t^3*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4;
    RScapAccelerationInputX=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
    RScapAccelerationInputY=AoY + (6*t^2*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4 - (6*t*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=RScapStartPositionX;
    PoY=RScapStartPositionY;
    VoX=RScapStartVelocityX;
    VoY=RScapStartVelocityY;
    PfX=TargetRScapPositionX;
    PfY=TargetRScapPositionY;
    VfX=TargetRScapVelocityX;
    VfY=TargetRScapVelocityY;
    AoX=RScapAoX;
    AoY=RScapAoY;
    AfX=RScapAfX;
    AfY=RScapAfY;
    RScapPositionInputX=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    RScapPositionInputY=PoY+VoY*t+(AoY*t^2)/2-(t^5*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(t^3*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(t^4*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^4);  
    RScapVelocityInputX=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    RScapVelocityInputY=VoY+AoY*t-(5*t^4*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    RScapAccelerationInputX=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    RScapAccelerationInputY=AoY-(3*t*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/Tt^3-(10*t^3*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/Tt^5+(6*t^2*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
end

% Calculate Higher Order Derivatives of the Position Outputs
RScapJerkX=gradient(RScapAccelerationInputX,t);
RScapJerkY=gradient(RScapAccelerationInputY,t);
RScapSnapX=gradient(RScapJerkX,t);
RScapSnapY=gradient(RScapJerkY,t);
RScapCrackleX=gradient(RScapSnapX,t);
RScapCrackleY=gradient(RScapSnapY,t);
RScapPopX=gradient(RScapCrackleX,t);
RScapPopY=gradient(RScapCrackleY,t);</P>
      </eml>
    </state>
    <data SSID="4" name="Time">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
