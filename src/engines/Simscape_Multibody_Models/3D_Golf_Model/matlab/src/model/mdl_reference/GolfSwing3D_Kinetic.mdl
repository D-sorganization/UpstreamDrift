__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_726.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="726">
  <P Name="name">Translation Input Function/GlobalBaseTranslationalForce</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">726</P>
  <P Name="ssIdHighWaterMark">113</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">15</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">726</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [TranslationForceX,TranslationForceY,TranslationForceZ,TranslationPositionInputX,TranslationPositionInputY,TranslationPositionInputZ,TranslationVelocityInputX,...
    TranslationVelocityInputY, TranslationVelocityInputZ,TranslationAccelerationInputX,TranslationAccelerationInputY,TranslationAccelerationInputZ] = fcn(Time,Killswitch, TranslationInputXA,TranslationInputYA,TranslationInputZA,TranslationInputXB,TranslationInputYB,TranslationInputZB, TranslationPositionSetpointX,TranslationPositionSetpointY,GlobalGain,...
    TranslationDampeningX, TranslationDampeningY, TranslationDampeningZ, TranslationConstantX, TranslationConstantY, TranslationConstantZ, TranslationTimeGainX, TranslationPositionGainY, TranslationPositionGainZ, TranslationPositionSetpointZ,...
    TargetTranslationPositionX, TargetTranslationPositionY, TargetTranslationPositionZ, TargetTranslationVelocityX, TargetTranslationVelocityY, TargetTranslationVelocityZ,TranslationPCGainX, TranslationPCGainY, TranslationPCGainZ, TranslationVCGainX,...
    TranslationVCGainY, TranslationVCGainZ,ModelingMode,ZVCFTranslationForceX, ZVCFTranslationForceY, ZVCFTranslationForceZ,GlobalPCGain, GlobalVCGain,DampeningGlobalGain,TargetImpactTime,TranslationStartPositionX,...
    TranslationStartPositionY, TranslationStartPositionZ, TranslationStartVelocityX, TranslationStartVelocityY, TranslationStartVelocityZ,TranslationPositionX, TranslationPositionY, TranslationPositionZ, TranslationInputYC, TranslationInputZC,...
TranslationInputXC, TranslationAoX, TranslationAoY, TranslationAoZ, TranslationPositionGainX, TranslationTimeGainY, TranslationTimeGainZ, TranslationVelocityX, TranslationVelocityY,...
TranslationVelocityZ,KinematicMode, TranslationAfX, TranslationAfY, TranslationAfZ,TranslationInputXD, TranslationInputXE, TranslationInputXF, TranslationInputXG, TranslationInputYD,...
TranslationInputYE, TranslationInputYF, TranslationInputYG, TranslationInputZD, TranslationInputZE, TranslationInputZF, TranslationInputZG, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    TranslationForceX=0;
    TranslationForceY=0;
    TranslationForceZ=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % Translation Joint Rotational Deltas
    DeltaTranslationPositionX=TranslationPositionX-TargetTranslationPositionX;
    DeltaTranslationPositionY=TranslationPositionY-TargetTranslationPositionY;
    DeltaTranslationPositionZ=TranslationPositionZ-TargetTranslationPositionZ;
    DeltaTranslationVelocityX=TranslationVelocityX-TargetTranslationVelocityX;
    DeltaTranslationVelocityY=TranslationVelocityY-TargetTranslationVelocityY;
    DeltaTranslationVelocityZ=TranslationVelocityZ-TargetTranslationVelocityZ;
    % Control Based Strategy
    TranslationForceX=DeltaTranslationPositionX*TranslationPCGainX*GlobalPCGain-DeltaTranslationVelocityX*TranslationVCGainX*GlobalVCGain-DampeningGlobalGain*TranslationDampeningX*(1-LocalDampeningEnable)*TranslationVelocityX;
    TranslationForceY=DeltaTranslationPositionY*TranslationPCGainY*GlobalPCGain-DeltaTranslationVelocityY*TranslationVCGainY*GlobalVCGain-DampeningGlobalGain*TranslationDampeningY*(1-LocalDampeningEnable)*TranslationVelocityY;
    TranslationForceZ=DeltaTranslationPositionZ*TranslationPCGainZ*GlobalPCGain-DeltaTranslationVelocityZ*TranslationVCGainZ*GlobalVCGain-DampeningGlobalGain*TranslationDampeningZ*(1-LocalDampeningEnable)*TranslationVelocityZ;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    TranslationForceX=Killswitch*GlobalGain*(TranslationConstantX+TranslationTimeGainX*Time-TranslationPositionGainX*(TranslationPositionX-TranslationPositionSetpointX)...
    -TranslationDampeningX*TranslationVelocityX);
    TranslationForceY=Killswitch*GlobalGain*(TranslationConstantY+TranslationTimeGainY*Time-TranslationPositionGainY*(TranslationPositionY-TranslationPositionSetpointY)...
    -TranslationDampeningY*TranslationVelocityY);
    TranslationForceZ=Killswitch*GlobalGain*(TranslationConstantZ+TranslationTimeGainZ*Time-TranslationPositionGainZ*(TranslationPositionZ-TranslationPositionSetpointZ)...
    -TranslationDampeningZ*TranslationVelocityZ);
elseif ModelingMode==3
    TranslationForceX=HexPolyInputFunction(TranslationInputXA,TranslationInputXB,TranslationInputXC,TranslationInputXD,TranslationInputXE,TranslationInputXF,TranslationInputXG,Time)*Killswitch;
    TranslationForceY=HexPolyInputFunction(TranslationInputYA,TranslationInputYB,TranslationInputYC,TranslationInputYD,TranslationInputYE,TranslationInputYF,TranslationInputYG,Time)*Killswitch;
    TranslationForceZ=HexPolyInputFunction(TranslationInputZA,TranslationInputZB,TranslationInputZC,TranslationInputZD,TranslationInputZE,TranslationInputZF,TranslationInputZG,Time)*Killswitch;
else
    %ZVCF Based Joint Forces. Values are pulled from model workspace and
    %held constant.
    TranslationForceX=ZVCFTranslationForceX;
    TranslationForceY=ZVCFTranslationForceY;
    TranslationForceZ=ZVCFTranslationForceZ;
end

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if KinematicMode==0
    % All kinematic values set to zero.
    TranslationPositionInputX=0;
    TranslationPositionInputY=0;
    TranslationPositionInputZ=0;
    TranslationVelocityInputX=0;
    TranslationVelocityInputY=0;
    TranslationVelocityInputZ=0;
    TranslationAccelerationInputX=0;
    TranslationAccelerationInputY=0;
    TranslationAccelerationInputZ=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetTranslationPositionX;       
    VTX=TargetTranslationVelocityX;
    PTY=TargetTranslationPositionY;
    VTY=TargetTranslationVelocityY;
    PTZ=TargetTranslationPositionZ;
    VTZ=TargetTranslationVelocityZ;
    % Define Starting Position and Velocity
    PIX=TranslationStartPositionX;
    VIX=TranslationStartVelocityX;
    PIY=TranslationStartPositionY;
    VIY=TranslationStartVelocityY;
    PIZ=TranslationStartPositionZ;
    VIZ=TranslationStartVelocityZ;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    AY=3*((VTY+VIY)*TargetImpactTime-2*(PTY-PIY))/TargetImpactTime^3;         % Constant in position equation
    BY=-2*((VTY+2*VIY)*TargetImpactTime-3*(PTY-PIY))/TargetImpactTime^2;         % Constant in position equation
    CY=VIY;         % Starting Velocity at Time Zero
    DY=PIY;         % Starting Position at Time Zero
    AZ=3*((VTZ+VIZ)*TargetImpactTime-2*(PTZ-PIZ))/TargetImpactTime^3;         % Constant in position equation
    BZ=-2*((VTZ+2*VIZ)*TargetImpactTime-3*(PTZ-PIZ))/TargetImpactTime^2;         % Constant in position equation
    CZ=VIZ;         % Starting Velocity at Time Zero
    DZ=PIZ;         % Starting Position at Time Zero
    % Equation for position as a function of time
    TranslationPositionInputX=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    TranslationPositionInputY=AY*Time^3/3+BY*Time^2/2+CY*Time+DY;
    TranslationPositionInputZ=AZ*Time^3/3+BZ*Time^2/2+CZ*Time+DZ;
    TranslationVelocityInputX=AX*Time^2+BX*Time+CX;
    TranslationVelocityInputY=AY*Time^2+BY*Time+CY;
    TranslationVelocityInputZ=AZ*Time^2+BZ*Time+CZ;
    TranslationAccelerationInputX=2*AX*Time+BX;
    TranslationAccelerationInputY=2*AY*Time+BY;
    TranslationAccelerationInputZ=2*AZ*Time+BZ;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=TranslationStartPositionX;
    PoY=TranslationStartPositionY;
    PoZ=TranslationStartPositionZ;
    VoX=TranslationStartVelocityX;
    VoY=TranslationStartVelocityY;
    VoZ=TranslationStartVelocityZ;
    PfX=TargetTranslationPositionX;
    PfY=TargetTranslationPositionY;
    PfZ=TargetTranslationPositionZ;
    VfX=TargetTranslationVelocityX;
    VfY=TargetTranslationVelocityY;
    VfZ=TargetTranslationVelocityZ;
    AoX=TranslationAoX;
    AoY=TranslationAoY;
    AoZ=TranslationAoZ;
    TranslationPositionInputX=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    TranslationPositionInputY=PoY + VoY*t + (AoY*t^2)/2 - (t^3*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (t^4*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/(2*Tt^4);
    TranslationPositionInputZ=PoZ + VoZ*t + (AoZ*t^2)/2 - (t^3*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3 + (t^4*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/(2*Tt^4);
    TranslationVelocityInputX=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    TranslationVelocityInputY=VoY + AoY*t - (3*t^2*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (2*t^3*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4;
    TranslationVelocityInputZ=VoZ + AoZ*t - (3*t^2*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3 + (2*t^3*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/Tt^4;
    TranslationAccelerationInputX=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
    TranslationAccelerationInputY=AoY + (6*t^2*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4 - (6*t*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3;
    TranslationAccelerationInputZ=AoZ + (6*t^2*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/Tt^4 - (6*t*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=TranslationStartPositionX;
    PoY=TranslationStartPositionY;
    PoZ=TranslationStartPositionZ;
    VoX=TranslationStartVelocityX;
    VoY=TranslationStartVelocityY;
    VoZ=TranslationStartVelocityZ;
    PfX=TargetTranslationPositionX;
    PfY=TargetTranslationPositionY;
    PfZ=TargetTranslationPositionZ;
    VfX=TargetTranslationVelocityX;
    VfY=TargetTranslationVelocityY;
    VfZ=TargetTranslationVelocityZ;
    AoX=TranslationAoX;
    AoY=TranslationAoY;
    AoZ=TranslationAoZ;
    AfX=TranslationAfX;
    AfY=TranslationAfY;
    AfZ=TranslationAfZ;
    TranslationPositionInputX=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    TranslationPositionInputY=PoY+VoY*t+(AoY*t^2)/2-(t^5*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(t^3*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(t^4*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^4);  
    TranslationPositionInputZ=PoZ+VoZ*t+(AoZ*t^2)/2-(t^5*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/(2*Tt^5)-(t^3*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^3)+(t^4*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^4);
    TranslationVelocityInputX=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    TranslationVelocityInputY=VoY+AoY*t-(5*t^4*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    TranslationVelocityInputZ=VoZ+AoZ*t-(5*t^4*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/Tt^4;
    TranslationAccelerationInputX=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    TranslationAccelerationInputY=AoY-(3*t*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/Tt^3-(10*t^3*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/Tt^5+(6*t^2*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    TranslationAccelerationInputZ=AoZ-(3*t*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/Tt^3-(10*t^3*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/Tt^5+(6*t^2*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/Tt^4;
end


% Calculate Higher Order Derivatives of the Position Outputs
TranslationJerkX=gradient(TranslationAccelerationInputX,t);
TranslationJerkY=gradient(TranslationAccelerationInputY,t);
TranslationJerkZ=gradient(TranslationAccelerationInputZ,t);
TranslationSnapX=gradient(TranslationJerkX,t);
TranslationSnapY=gradient(TranslationJerkY,t);
TranslationSnapZ=gradient(TranslationJerkZ,t);
TranslationCrackleX=gradient(TranslationSnapX,t);
TranslationCrackleY=gradient(TranslationSnapY,t);
TranslationCrackleZ=gradient(TranslationSnapZ,t);
TranslationPopX=gradient(TranslationCrackleX,t);
TranslationPopY=gradient(TranslationCrackleY,t);
TranslationPopZ=gradient(TranslationCrackleZ,t);

</P>
      </eml>
    </state>
    <data SSID="13" name="Time">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="19" name="Killswitch">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="27" name="TranslationInputXA">
      <P Name="scope">PARAMETER_DATA</P>
      <P Name="paramIndexForInitFromWorkspace">26</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="28" name="TranslationInputYA">
      <P Name="scope">PARAMETER_DATA</P>
      <P Name="paramIndexForInitFromWorkspace">33</P>
