__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_976.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="976">
  <P Name="name">RS Input Function/Right Shoulder Torque Output</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">976</P>
  <P Name="ssIdHighWaterMark">104</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">20</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">976</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [JointTorqueRSX,JointTorqueRSY,JointTorqueRSZ,RSPositionInputX,RSPositionInputY,RSPositionInputZ,RSVelocityInputX,...
    RSVelocityInputY, RSVelocityInputZ,RSAccelerationInputX,RSAccelerationInputY,RSAccelerationInputZ] = fcn(Time,Killswitch, RSInputXA,RSInputYA,RSInputZA, RSInputXB,RSInputYB,RSInputZB, RSPositionSetpointX,RSPositionSetpointY,GlobalGain,...
    RSDampeningX, RSDampeningY, RSDampeningZ, RSConstantX, RSConstantY, RSConstantZ, RSTimeGainX, RSPositionGainY, RSPositionGainZ, RSPositionSetpointZ,...
    TargetRSPositionX, TargetRSPositionY, TargetRSPositionZ, TargetRSVelocityX, TargetRSVelocityY, TargetRSVelocityZ,RSPCGainX, RSPCGainY, RSPCGainZ, RSVCGainX,...
    RSVCGainY, RSVCGainZ,ModelingMode,ZVCFRSTorqueX, ZVCFRSTorqueY, ZVCFRSTorqueZ,GlobalPCGain, GlobalVCGain,DampeningGlobalGain,TargetImpactTime,RSStartPositionX,...
    RSStartPositionY, RSStartPositionZ, RSStartVelocityX, RSStartVelocityY, RSStartVelocityZ,RSAoX, RSAoY, RSAoZ, KinematicMode, RSPositionX, RSPositionY, RSPositionZ, RSVelocityX, RSVelocityY,...
    RSVelocityZ,RSTimeGainY, RSTimeGainZ, RSInputZC,...
    RSInputYC, RSInputXC, RSPositionGainX, RSAfX, RSAfY, RSAfZ,RSInputXD, RSInputXE, RSInputXF, RSInputXG,...
RSInputYD, RSInputYE, RSInputYF, RSInputYG, RSInputZD, RSInputZE, RSInputZF, RSInputZG, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    JointTorqueRSX=0;
    JointTorqueRSY=0;
    JointTorqueRSZ=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % RS Joint Rotational Deltas
    DeltaRSPositionX=RSPositionX-TargetRSPositionX;
    DeltaRSPositionY=RSPositionY-TargetRSPositionY;
    DeltaRSPositionZ=RSPositionZ-TargetRSPositionZ;
    DeltaRSVelocityX=RSVelocityX-TargetRSVelocityX;
    DeltaRSVelocityY=RSVelocityY-TargetRSVelocityY;
    DeltaRSVelocityZ=RSVelocityZ-TargetRSVelocityZ;
    % Control Based Strategy
    JointTorqueRSX=DeltaRSPositionX*RSPCGainX*GlobalPCGain-DeltaRSVelocityX*RSVCGainX*GlobalVCGain-DampeningGlobalGain*RSDampeningX*(1-LocalDampeningEnable)*RSVelocityX;
    JointTorqueRSY=DeltaRSPositionY*RSPCGainY*GlobalPCGain-DeltaRSVelocityY*RSVCGainY*GlobalVCGain-DampeningGlobalGain*RSDampeningY*(1-LocalDampeningEnable)*RSVelocityY;
    JointTorqueRSZ=DeltaRSPositionZ*RSPCGainZ*GlobalPCGain-DeltaRSVelocityZ*RSVCGainZ*GlobalVCGain-DampeningGlobalGain*RSDampeningZ*(1-LocalDampeningEnable)*RSVelocityZ;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    JointTorqueRSX=Killswitch*GlobalGain*(RSConstantX+RSTimeGainX*Time-RSPositionGainX*(RSPositionX-RSPositionSetpointX)...
    -RSDampeningX*RSVelocityX);
    JointTorqueRSY=Killswitch*GlobalGain*(RSConstantY+RSTimeGainY*Time-RSPositionGainY*(RSPositionY-RSPositionSetpointY)...
    -RSDampeningY*RSVelocityY);
    JointTorqueRSZ=Killswitch*GlobalGain*(RSConstantZ+RSTimeGainZ*Time-RSPositionGainZ*(RSPositionZ-RSPositionSetpointZ)...
    -RSDampeningZ*RSVelocityZ);
elseif ModelingMode==3
    JointTorqueRSX=HexPolyInputFunction(RSInputXA,RSInputXB,RSInputXC,RSInputXD,RSInputXE,RSInputXF,RSInputXG,Time)*Killswitch;
    JointTorqueRSY=HexPolyInputFunction(RSInputYA,RSInputYB,RSInputYC,RSInputYD,RSInputYE,RSInputYF,RSInputYG,Time)*Killswitch;
    JointTorqueRSZ=HexPolyInputFunction(RSInputZA,RSInputZB,RSInputZC,RSInputZD,RSInputZE,RSInputZF,RSInputZG,Time)*Killswitch;
else
    %ZVCF Based Joint Torques. Values are pulled from model workspace and
    %held constant.
    JointTorqueRSX=ZVCFRSTorqueX;
    JointTorqueRSY=ZVCFRSTorqueY;
    JointTorqueRSZ=ZVCFRSTorqueZ;
end

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if KinematicMode==0
    % All kinematic values set to zero.
    RSPositionInputX=0;
    RSPositionInputY=0;
    RSPositionInputZ=0;
    RSVelocityInputX=0;
    RSVelocityInputY=0;
    RSVelocityInputZ=0;
    RSAccelerationInputX=0;
    RSAccelerationInputY=0;
    RSAccelerationInputZ=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetRSPositionX;       
    VTX=TargetRSVelocityX;
    PTY=TargetRSPositionY;
    VTY=TargetRSVelocityY;
    PTZ=TargetRSPositionZ;
    VTZ=TargetRSVelocityZ;
    % Define Starting Position and Velocity
    PIX=RSStartPositionX;
    VIX=RSStartVelocityX;
    PIY=RSStartPositionY;
    VIY=RSStartVelocityY;
    PIZ=RSStartPositionZ;
    VIZ=RSStartVelocityZ;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    AY=3*((VTY+VIY)*TargetImpactTime-2*(PTY-PIY))/TargetImpactTime^3;         % Constant in position equation
    BY=-2*((VTY+2*VIY)*TargetImpactTime-3*(PTY-PIY))/TargetImpactTime^2;         % Constant in position equation
    CY=VIY;         % Starting Velocity at Time Zero
    DY=PIY;         % Starting Position at Time Zero
    AZ=3*((VTZ+VIZ)*TargetImpactTime-2*(PTZ-PIZ))/TargetImpactTime^3;         % Constant in position equation
    BZ=-2*((VTZ+2*VIZ)*TargetImpactTime-3*(PTZ-PIZ))/TargetImpactTime^2;         % Constant in position equation
    CZ=VIZ;         % Starting Velocity at Time Zero
    DZ=PIZ;         % Starting Position at Time Zero
    % Equation for position as a function of time
    RSPositionInputX=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    RSPositionInputY=AY*Time^3/3+BY*Time^2/2+CY*Time+DY;
    RSPositionInputZ=AZ*Time^3/3+BZ*Time^2/2+CZ*Time+DZ;
    RSVelocityInputX=AX*Time^2+BX*Time+CX;
    RSVelocityInputY=AY*Time^2+BY*Time+CY;
    RSVelocityInputZ=AZ*Time^2+BZ*Time+CZ;
    RSAccelerationInputX=2*AX*Time+BX;
    RSAccelerationInputY=2*AY*Time+BY;
    RSAccelerationInputZ=2*AZ*Time+BZ;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=RSStartPositionX;
    PoY=RSStartPositionY;
    PoZ=RSStartPositionZ;
    VoX=RSStartVelocityX;
    VoY=RSStartVelocityY;
    VoZ=RSStartVelocityZ;
    PfX=TargetRSPositionX;
    PfY=TargetRSPositionY;
    PfZ=TargetRSPositionZ;
    VfX=TargetRSVelocityX;
    VfY=TargetRSVelocityY;
    VfZ=TargetRSVelocityZ;
    AoX=RSAoX;
    AoY=RSAoY;
    AoZ=RSAoZ;
    RSPositionInputX=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    RSPositionInputY=PoY + VoY*t + (AoY*t^2)/2 - (t^3*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (t^4*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/(2*Tt^4);
    RSPositionInputZ=PoZ + VoZ*t + (AoZ*t^2)/2 - (t^3*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3 + (t^4*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/(2*Tt^4);
    RSVelocityInputX=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    RSVelocityInputY=VoY + AoY*t - (3*t^2*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (2*t^3*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4;
    RSVelocityInputZ=VoZ + AoZ*t - (3*t^2*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3 + (2*t^3*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/Tt^4;
    RSAccelerationInputX=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
    RSAccelerationInputY=AoY + (6*t^2*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4 - (6*t*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3;
    RSAccelerationInputZ=AoZ + (6*t^2*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/Tt^4 - (6*t*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=RSStartPositionX;
    PoY=RSStartPositionY;
    PoZ=RSStartPositionZ;
    VoX=RSStartVelocityX;
    VoY=RSStartVelocityY;
    VoZ=RSStartVelocityZ;
    PfX=TargetRSPositionX;
    PfY=TargetRSPositionY;
    PfZ=TargetRSPositionZ;
    VfX=TargetRSVelocityX;
    VfY=TargetRSVelocityY;
    VfZ=TargetRSVelocityZ;
    AoX=RSAoX;
    AoY=RSAoY;
    AoZ=RSAoZ;
    AfX=RSAfX;
    AfY=RSAfY;
    AfZ=RSAfZ;
    RSPositionInputX=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    RSPositionInputY=PoY+VoY*t+(AoY*t^2)/2-(t^5*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(t^3*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(t^4*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^4);  
    RSPositionInputZ=PoZ+VoZ*t+(AoZ*t^2)/2-(t^5*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/(2*Tt^5)-(t^3*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^3)+(t^4*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^4);
    RSVelocityInputX=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    RSVelocityInputY=VoY+AoY*t-(5*t^4*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    RSVelocityInputZ=VoZ+AoZ*t-(5*t^4*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/Tt^4;
    RSAccelerationInputX=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    RSAccelerationInputY=AoY-(3*t*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/Tt^3-(10*t^3*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/Tt^5+(6*t^2*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    RSAccelerationInputZ=AoZ-(3*t*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/Tt^3-(10*t^3*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/Tt^5+(6*t^2*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/Tt^4;
end


% Calculate Higher Order Derivatives of the Position Outputs
RSJerkX=gradient(RSAccelerationInputX,t);
RSJerkY=gradient(RSAccelerationInputY,t);
RSJerkZ=gradient(RSAccelerationInputZ,t);
RSSnapX=gradient(RSJerkX,t);
RSSnapY=gradient(RSJerkY,t);
RSSnapZ=gradient(RSJerkZ,t);
RSCrackleX=gradient(RSSnapX,t);
RSCrackleY=gradient(RSSnapY,t);
RSCrackleZ=gradient(RSSnapZ,t);
RSPopX=gradient(RSCrackleX,t);
RSPopY=gradient(RSCrackleY,t);
RSPopZ=gradient(RSCrackleZ,t);
</P>
      </eml>
    </state>
