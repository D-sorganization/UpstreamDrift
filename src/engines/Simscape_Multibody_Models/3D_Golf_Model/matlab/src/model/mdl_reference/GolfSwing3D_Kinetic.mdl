__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_448.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="448">
  <P Name="name">LW Input Function/Left Wrist Torque</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">448</P>
  <P Name="ssIdHighWaterMark">84</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">9</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">448</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [JointTorqueLWX,JointTorqueLWY,LWPositionInputX, LWPositionInputY,...
    LWVelocityInputX,LWVelocityInputY,LWAccelerationInputX,LWAccelerationInputY,...
    LWJointTorqueInputGlobal]...
    = fcn(Time,Killswitch, LWInputXA,LWInputYA, LWInputXB,LWInputYB, LWPositionSetpointX,GlobalGain,...
    LWConstantX, LWConstantY, LWTimeGainX, LWTimeGainY,...
    LWInputXC, LWInputYC, LWPositionGainX, LWPositionGainY,...
    TargetLWPositionX, ModelingMode,GlobalPCGain, GlobalVCGain,DampeningGlobalGain,TargetImpactTime,KinematicMode, LWPositionSetpointY, LWStartPositionX,...
    LWStartPositionY, LWStartVelocityX, LWStartVelocityY, LWVCGainX,...
    LWVCGainY, LWPCGainX, LWPCGainY, ZVCFLWTorqueX, ZVCFLWTorqueY, LWAoX,...
    LWAoY, LWDampeningX, LWDampeningY, TargetLWPositionY, TargetLWVelocityX,...
    TargetLWVelocityY, LWPositionX, LWPositionY, LWVelocityX, LWVelocityY,...
    LWAfX, LWAfY,LWInputXD, LWInputXE, LWInputXF, LWInputXG, LWInputYD, LWInputYE, LWInputYF, LWInputYG,LWLocaltoGlobalR, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    JointTorqueLWX=0;
    JointTorqueLWY=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % LW Joint Rotational Deltas
    DeltaLWPositionX=LWPositionX-TargetLWPositionX;
    DeltaLWPositionY=LWPositionY-TargetLWPositionY;
    DeltaLWVelocityX=LWVelocityX-TargetLWVelocityX;
    DeltaLWVelocityY=LWVelocityY-TargetLWVelocityY;
    % Control Based Strategy
    JointTorqueLWX=DeltaLWPositionX*LWPCGainX*GlobalPCGain-DeltaLWVelocityX*LWVCGainX*GlobalVCGain-DampeningGlobalGain*LWDampeningX*(1-LocalDampeningEnable)*LWVelocityX;
    JointTorqueLWY=DeltaLWPositionY*LWPCGainY*GlobalPCGain-DeltaLWVelocityY*LWVCGainY*GlobalVCGain-DampeningGlobalGain*LWDampeningY*(1-LocalDampeningEnable)*LWVelocityY;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    JointTorqueLWX=Killswitch*GlobalGain*(LWConstantX+LWTimeGainX*Time-LWPositionGainX*(LWPositionX-LWPositionSetpointX)...
    -LWDampeningX*LWVelocityX);
    JointTorqueLWY=Killswitch*GlobalGain*(LWConstantY+LWTimeGainY*Time-LWPositionGainY*(LWPositionY-LWPositionSetpointY)...
    -LWDampeningY*LWVelocityY);
elseif ModelingMode==3
    JointTorqueLWX=HexPolyInputFunction(LWInputXA,LWInputXB,LWInputXC,LWInputXD,LWInputXE,LWInputXF,LWInputXG,Time)*Killswitch;
    JointTorqueLWY=HexPolyInputFunction(LWInputYA,LWInputYB,LWInputYC,LWInputYD,LWInputYE,LWInputYF,LWInputYG,Time)*Killswitch;  
else
    %ZVCF Based Joint Torques. Values are pulled from model workspace and
    %held constant.
    JointTorqueLWX=ZVCFLWTorqueX;
    JointTorqueLWY=ZVCFLWTorqueY;
end

% Create a global vector of the joint torque inputs
LWJointTorqueInputLocal=cat(1,JointTorqueLWX,JointTorqueLWY,0);
LWJointTorqueInputGlobal=LWLocaltoGlobalR*LWJointTorqueInputLocal;


% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if KinematicMode==0
    % All kinematic values set to zero.
    LWPositionInputX=0;
    LWPositionInputY=0;
    LWVelocityInputX=0;
    LWVelocityInputY=0;
    LWAccelerationInputX=0;
    LWAccelerationInputY=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetLWPositionX;       
    VTX=TargetLWVelocityX;
    PTY=TargetLWPositionY;
    VTY=TargetLWVelocityY;
    % Define Starting Position and Velocity
    PIX=LWStartPositionX;
    VIX=LWStartVelocityX;
    PIY=LWStartPositionY;
    VIY=LWStartVelocityY;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    AY=3*((VTY+VIY)*TargetImpactTime-2*(PTY-PIY))/TargetImpactTime^3;         % Constant in position equation
    BY=-2*((VTY+2*VIY)*TargetImpactTime-3*(PTY-PIY))/TargetImpactTime^2;         % Constant in position equation
    CY=VIY;         % Starting Velocity at Time Zero
    DY=PIY;         % Starting Position at Time Zero
    % Equation for position as a function of time
    LWPositionInputX=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    LWPositionInputY=AY*Time^3/3+BY*Time^2/2+CY*Time+DY;
    LWVelocityInputX=AX*Time^2+BX*Time+CX;
    LWVelocityInputY=AY*Time^2+BY*Time+CY;
    LWAccelerationInputX=2*AX*Time+BX;
    LWAccelerationInputY=2*AY*Time+BY;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=LWStartPositionX;
    PoY=LWStartPositionY;
    VoX=LWStartVelocityX;
    VoY=LWStartVelocityY;
    PfX=TargetLWPositionX;
    PfY=TargetLWPositionY;
    VfX=TargetLWVelocityX;
    VfY=TargetLWVelocityY;
    AoX=LWAoX;
    AoY=LWAoY;
    LWPositionInputX=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    LWPositionInputY=PoY + VoY*t + (AoY*t^2)/2 - (t^3*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (t^4*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/(2*Tt^4);
    LWVelocityInputX=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    LWVelocityInputY=VoY + AoY*t - (3*t^2*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (2*t^3*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4;
    LWAccelerationInputX=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
    LWAccelerationInputY=AoY + (6*t^2*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4 - (6*t*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=LWStartPositionX;
    PoY=LWStartPositionY;
    VoX=LWStartVelocityX;
    VoY=LWStartVelocityY;
    PfX=TargetLWPositionX;
    PfY=TargetLWPositionY;
    VfX=TargetLWVelocityX;
    VfY=TargetLWVelocityY;
    AoX=LWAoX;
    AoY=LWAoY;
    AfX=LWAfX;
    AfY=LWAfY;
    LWPositionInputX=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    LWPositionInputY=PoY+VoY*t+(AoY*t^2)/2-(t^5*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(t^3*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(t^4*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^4);  
    LWVelocityInputX=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    LWVelocityInputY=VoY+AoY*t-(5*t^4*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    LWAccelerationInputX=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    LWAccelerationInputY=AoY-(3*t*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/Tt^3-(10*t^3*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/Tt^5+(6*t^2*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
end


% Calculate Higher Order Derivatives of the Position Outputs
LWJerkX=gradient(LWAccelerationInputX,t);
LWJerkY=gradient(LWAccelerationInputY,t);
LWSnapX=gradient(LWJerkX,t);
LWSnapY=gradient(LWJerkY,t);
LWCrackleX=gradient(LWSnapX,t);
LWCrackleY=gradient(LWSnapY,t);
LWPopX=gradient(LWCrackleX,t);
LWPopY=gradient(LWCrackleY,t);</P>
      </eml>
    </state>
