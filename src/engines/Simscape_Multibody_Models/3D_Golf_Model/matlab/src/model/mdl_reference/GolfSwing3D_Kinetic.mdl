__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_116.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="116">
  <P Name="name">Hip Input Function/Hip Torque Output</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">116</P>
  <P Name="ssIdHighWaterMark">97</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">1</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">116</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [JointTorqueHipX,JointTorqueHipY,JointTorqueHipZ,HipPositionInputX,HipPositionInputY,HipPositionInputZ,HipVelocityInputX,...
    HipVelocityInputY, HipVelocityInputZ,HipAccelerationInputX,HipAccelerationInputY,HipAccelerationInputZ] = fcn(Time,Killswitch, HipAngularPositionX,HipAngularPositionY,HipAngularPositionZ, HipAngularVelocityX,HipAngularVelocityY,...
    HipAngularVelocityZ,...
    HipInputXA,HipInputYA,HipInputZA, HipInputXB,HipInputYB,HipInputZB, HipPositionSetpointX,HipPositionSetpointY,GlobalGain,...
    HipDampeningX, HipDampeningY, HipDampeningZ, HipConstantX, HipConstantY, HipConstantZ, HipTimeGainX, HipTimeGainY, HipTimeGainZ, HipInputZC,...
    HipInputXC, HipInputYC, HipPositionGainX, HipPositionGainY, HipPositionGainZ, HipPositionSetpointZ,...
    TargetHipPositionX, TargetHipPositionY, TargetHipPositionZ, TargetHipVelocityX, TargetHipVelocityY, TargetHipVelocityZ,HipPCGainX, HipPCGainY, HipPCGainZ, HipVCGainX,...
    HipVCGainY, HipVCGainZ,ModelingMode,ZVCFHipTorqueX, ZVCFHipTorqueY, ZVCFHipTorqueZ,GlobalPCGain, GlobalVCGain,DampeningGlobalGain,TargetImpactTime,HipStartPositionX,...
    HipStartPositionY, HipStartPositionZ, HipStartVelocityX, HipStartVelocityY, HipStartVelocityZ,KinematicMode,HipAoX, HipAoY, HipAoZ,HipAfX, HipAfY, HipAfZ,...
    HipInputXD, HipInputYD, HipInputXE, HipInputXF, HipInputXG, HipInputYE, HipInputYF, HipInputYG, HipInputZD, HipInputZE, HipInputZF, HipInputZG, LocalDampeningEnable)

%Tau=Time/TargetImpactTime;
t=Time;

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinetic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if ModelingMode==0
    % Values are all set to zero.
    JointTorqueHipX=0;
    JointTorqueHipY=0;
    JointTorqueHipZ=0;
elseif ModelingMode==1
    % Control based strategy. Values are based on difference in value
    % between the current state and desired state.
    % Hip Joint Rotational Deltas
    DeltaHipPositionX=HipAngularPositionX-TargetHipPositionX;
    DeltaHipPositionY=HipAngularPositionY-TargetHipPositionY;
    DeltaHipPositionZ=HipAngularPositionZ-TargetHipPositionZ;
    DeltaHipVelocityX=HipAngularVelocityX-TargetHipVelocityX;
    DeltaHipVelocityY=HipAngularVelocityY-TargetHipVelocityY;
    DeltaHipVelocityZ=HipAngularVelocityZ-TargetHipVelocityZ;
    % Control Based Strategy
    JointTorqueHipX=DeltaHipPositionX*HipPCGainX*GlobalPCGain-DeltaHipVelocityX*HipVCGainX*GlobalVCGain-DampeningGlobalGain*HipDampeningX*(1-LocalDampeningEnable)*HipAngularVelocityX;
    JointTorqueHipY=DeltaHipPositionY*HipPCGainY*GlobalPCGain-DeltaHipVelocityY*HipVCGainY*GlobalVCGain-DampeningGlobalGain*HipDampeningY*(1-LocalDampeningEnable)*HipAngularVelocityY;
    JointTorqueHipZ=DeltaHipPositionZ*HipPCGainZ*GlobalPCGain-DeltaHipVelocityZ*HipVCGainZ*GlobalVCGain-DampeningGlobalGain*HipDampeningZ*(1-LocalDampeningEnable)*HipAngularVelocityZ;
elseif ModelingMode==2
    % Forward Dynamics Based Strategy. Values are computed based on a
    % polynomial and a combination of dampening and position gained
    % factors.
    JointTorqueHipX=Killswitch*GlobalGain*(HipConstantX+HipTimeGainX*Time-HipPositionGainX*(HipAngularPositionX-HipPositionSetpointX)...
    -HipDampeningX*HipAngularVelocityX);
    JointTorqueHipY=Killswitch*GlobalGain*(HipConstantY+HipTimeGainY*Time-HipPositionGainY*(HipAngularPositionY-HipPositionSetpointY)...
    -HipDampeningY*HipAngularVelocityY);
    JointTorqueHipZ=Killswitch*GlobalGain*(HipConstantZ+HipTimeGainZ*Time-HipPositionGainZ*(HipAngularPositionZ-HipPositionSetpointZ)...
    -HipDampeningZ*HipAngularVelocityZ);
elseif ModelingMode==3
    JointTorqueHipX=HexPolyInputFunction(HipInputXA,HipInputXB,HipInputXC,HipInputXD,HipInputXE,HipInputXF,HipInputXG,Time)*Killswitch;
    JointTorqueHipY=HexPolyInputFunction(HipInputYA,HipInputYB,HipInputYC,HipInputYD,HipInputYE,HipInputYF,HipInputYG,Time)*Killswitch;
    JointTorqueHipZ=HexPolyInputFunction(HipInputZA,HipInputZB,HipInputZC,HipInputZD,HipInputZE,HipInputZF,HipInputZG,Time)*Killswitch;
else
    %ZVCF Based Joint Torques. Values are pulled from model workspace and
    %held constant.
    JointTorqueHipX=ZVCFHipTorqueX;
    JointTorqueHipY=ZVCFHipTorqueY;
    JointTorqueHipZ=ZVCFHipTorqueZ;
end

% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Kinematic Input Selection and Calculation
% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

if KinematicMode==0
    % All kinematic values set to zero.
    HipPositionInputX=0;
    HipPositionInputY=0;
    HipPositionInputZ=0;
    HipVelocityInputX=0;
    HipVelocityInputY=0;
    HipVelocityInputZ=0;
    HipAccelerationInputX=0;
    HipAccelerationInputY=0;
    HipAccelerationInputZ=0;
elseif KinematicMode==1
    % 1st Order Acceleration, 2nd Order Velocity, 3rd Order Position Solution
    PTX=TargetHipPositionX;       
    VTX=TargetHipVelocityX;
    PTY=TargetHipPositionY;
    VTY=TargetHipVelocityY;
    PTZ=TargetHipPositionZ;
    VTZ=TargetHipVelocityZ;
    % Define Starting Position and Velocity
    PIX=HipStartPositionX;
    VIX=HipStartVelocityX;
    PIY=HipStartPositionY;
    VIY=HipStartVelocityY;
    PIZ=HipStartPositionZ;
    VIZ=HipStartVelocityZ;
    AX=3*((VTX+VIX)*TargetImpactTime-2*(PTX-PIX))/TargetImpactTime^3;         % Constant in position equation
    BX=-2*((VTX+2*VIX)*TargetImpactTime-3*(PTX-PIX))/TargetImpactTime^2;         % Constant in position equation
    CX=VIX;         % Starting Velocity at Time Zero
    DX=PIX;         % Starting Position at Time Zero
    AY=3*((VTY+VIY)*TargetImpactTime-2*(PTY-PIY))/TargetImpactTime^3;         % Constant in position equation
    BY=-2*((VTY+2*VIY)*TargetImpactTime-3*(PTY-PIY))/TargetImpactTime^2;         % Constant in position equation
    CY=VIY;         % Starting Velocity at Time Zero
    DY=PIY;         % Starting Position at Time Zero
    AZ=3*((VTZ+VIZ)*TargetImpactTime-2*(PTZ-PIZ))/TargetImpactTime^3;         % Constant in position equation
    BZ=-2*((VTZ+2*VIZ)*TargetImpactTime-3*(PTZ-PIZ))/TargetImpactTime^2;         % Constant in position equation
    CZ=VIZ;         % Starting Velocity at Time Zero
    DZ=PIZ;         % Starting Position at Time Zero
    % Equation for position as a function of time
    HipPositionInputX=AX*Time^3/3+BX*Time^2/2+CX*Time+DX;
    HipPositionInputY=AY*Time^3/3+BY*Time^2/2+CY*Time+DY;
    HipPositionInputZ=AZ*Time^3/3+BZ*Time^2/2+CZ*Time+DZ;
    HipVelocityInputX=AX*Time^2+BX*Time+CX;
    HipVelocityInputY=AY*Time^2+BY*Time+CY;
    HipVelocityInputZ=AZ*Time^2+BZ*Time+CZ;
    HipAccelerationInputX=2*AX*Time+BX;
    HipAccelerationInputY=2*AY*Time+BY;
    HipAccelerationInputZ=2*AZ*Time+BZ;
elseif KinematicMode==2
    % 2nd Order Acceleration, 3rd Order Velocity, 4th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=HipStartPositionX;
    PoY=HipStartPositionY;
    PoZ=HipStartPositionZ;
    VoX=HipStartVelocityX;
    VoY=HipStartVelocityY;
    VoZ=HipStartVelocityZ;
    PfX=TargetHipPositionX;
    PfY=TargetHipPositionY;
    PfZ=TargetHipPositionZ;
    VfX=TargetHipVelocityX;
    VfY=TargetHipVelocityY;
    VfZ=TargetHipVelocityZ;
    AoX=HipAoX;
    AoY=HipAoY;
    AoZ=HipAoZ;
    HipPositionInputX=PoX + VoX*t + (AoX*t^2)/2 - (t^3*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (t^4*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/(2*Tt^4);
    HipPositionInputY=PoY + VoY*t + (AoY*t^2)/2 - (t^3*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (t^4*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/(2*Tt^4);
    HipPositionInputZ=PoZ + VoZ*t + (AoZ*t^2)/2 - (t^3*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3 + (t^4*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/(2*Tt^4);
    HipVelocityInputX=VoX + AoX*t - (3*t^2*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3 + (2*t^3*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4;
    HipVelocityInputY=VoY + AoY*t - (3*t^2*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3 + (2*t^3*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4;
    HipVelocityInputZ=VoZ + AoZ*t - (3*t^2*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3 + (2*t^3*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/Tt^4;
    HipAccelerationInputX=AoX + (6*t^2*(6*PoX - 6*PfX + 2*Tt*VfX + 4*Tt*VoX + AoX*Tt^2))/Tt^4 - (6*t*(4*PoX - 4*PfX + Tt*VfX + 3*Tt*VoX + AoX*Tt^2))/Tt^3;
    HipAccelerationInputY=AoY + (6*t^2*(6*PoY - 6*PfY + 2*Tt*VfY + 4*Tt*VoY + AoY*Tt^2))/Tt^4 - (6*t*(4*PoY - 4*PfY + Tt*VfY + 3*Tt*VoY + AoY*Tt^2))/Tt^3;
    HipAccelerationInputZ=AoZ + (6*t^2*(6*PoZ - 6*PfZ + 2*Tt*VfZ + 4*Tt*VoZ + AoZ*Tt^2))/Tt^4 - (6*t*(4*PoZ - 4*PfZ + Tt*VfZ + 3*Tt*VoZ + AoZ*Tt^2))/Tt^3;
else
    % 3rd Order Acceleration, 4th Order Velocity, 5th Order Position Solution
    Tt=TargetImpactTime;
    t=Time;
    PoX=HipStartPositionX;
    PoY=HipStartPositionY;
    PoZ=HipStartPositionZ;
    VoX=HipStartVelocityX;
    VoY=HipStartVelocityY;
    VoZ=HipStartVelocityZ;
    PfX=TargetHipPositionX;
    PfY=TargetHipPositionY;
    PfZ=TargetHipPositionZ;
    VfX=TargetHipVelocityX;
    VfY=TargetHipVelocityY;
    VfZ=TargetHipVelocityZ;
    AoX=HipAoX;
    AoY=HipAoY;
    AoZ=HipAoZ;
    AfX=HipAfX;
    AfY=HipAfY;
    AfZ=HipAfZ;
    HipPositionInputX=PoX+VoX*t+(AoX*t^2)/2-(t^5*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(t^3*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(t^4*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^4);
    HipPositionInputY=PoY+VoY*t+(AoY*t^2)/2-(t^5*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(t^3*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(t^4*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^4);  
    HipPositionInputZ=PoZ+VoZ*t+(AoZ*t^2)/2-(t^5*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/(2*Tt^5)-(t^3*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^3)+(t^4*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^4);
    HipVelocityInputX=VoX+AoX*t-(5*t^4*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    HipVelocityInputY=VoY+AoY*t-(5*t^4*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    HipVelocityInputZ=VoZ+AoZ*t-(5*t^4*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/(2*Tt^5)-(3*t^2*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/(2*Tt^3)+(2*t^3*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/Tt^4;
    HipAccelerationInputX=AoX-(3*t*(20*PoX-20*PfX+8*Tt*VfX+12*Tt*VoX-AfX*Tt^2+3*AoX*Tt^2))/Tt^3-(10*t^3*(12*PoX-12*PfX+6*Tt*VfX+6*Tt*VoX-AfX*Tt^2+AoX*Tt^2))/Tt^5+(6*t^2*(30*PoX-30*PfX+14*Tt*VfX+16*Tt*VoX-2*AfX*Tt^2+3*AoX*Tt^2))/Tt^4;
    HipAccelerationInputY=AoY-(3*t*(20*PoY-20*PfY+8*Tt*VfY+12*Tt*VoY-AfY*Tt^2+3*AoY*Tt^2))/Tt^3-(10*t^3*(12*PoY-12*PfY+6*Tt*VfY+6*Tt*VoY-AfY*Tt^2+AoY*Tt^2))/Tt^5+(6*t^2*(30*PoY-30*PfY+14*Tt*VfY+16*Tt*VoY-2*AfY*Tt^2+3*AoY*Tt^2))/Tt^4;
    HipAccelerationInputZ=AoZ-(3*t*(20*PoZ-20*PfZ+8*Tt*VfZ+12*Tt*VoZ-AfZ*Tt^2+3*AoZ*Tt^2))/Tt^3-(10*t^3*(12*PoZ-12*PfZ+6*Tt*VfZ+6*Tt*VoZ-AfZ*Tt^2+AoZ*Tt^2))/Tt^5+(6*t^2*(30*PoZ-30*PfZ+14*Tt*VfZ+16*Tt*VoZ-2*AfZ*Tt^2+3*AoZ*Tt^2))/Tt^4;
end

% Calculate Higher Order Derivatives of the Position Outputs
HipJerkX=gradient(HipAccelerationInputX,t);
HipJerkY=gradient(HipAccelerationInputY,t);
HipJerkZ=gradient(HipAccelerationInputZ,t);
HipSnapX=gradient(HipJerkX,t);
HIpSnapY=gradient(HipJerkY,t);
HipSnapZ=gradient(HipJerkZ,t);
HipCrackleX=gradient(HipSnapX,t);
HipCrackleY=gradient(HIpSnapY,t);
HipCrackleZ=gradient(HipSnapZ,t);
HipPopX=gradient(HipCrackleX,t);
HipPopY=gradient(HipCrackleY,t);
HipPopZ=gradient(HipCrackleZ,t);</P>
      </eml>
    </state>
    <data SSID="5" name="JointTorqueHipX">
