<?xml version="1.0" encoding="UTF-8"?>
<robot name="simple_quadruped">
  <material name="body_color">
    <color rgba="0.4 0.4 0.5 1.0"/>
  </material>
  <material name="leg_color">
    <color rgba="0.6 0.6 0.65 1.0"/>
  </material>

  <!-- Body -->
  <link name="body">
    <visual>
      <geometry><box size="0.40 0.15 0.08"/></geometry>
      <material name="body_color"/>
    </visual>
    <collision>
      <geometry><box size="0.40 0.15 0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0120" iyy="0.0700" izz="0.0740" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Front Right Upper Leg -->
  <link name="fr_upper_leg">
    <visual>
      <geometry><capsule radius="0.02" length="0.12"/></geometry>
      <material name="leg_color"/>
    </visual>
    <collision>
      <geometry><capsule radius="0.02" length="0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.06"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="fr_hip" type="revolute">
    <parent link="body"/>
    <child link="fr_upper_leg"/>
    <origin xyz="0.15 -0.09 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="50" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- Front Right Lower Leg -->
  <link name="fr_lower_leg">
    <visual>
      <geometry><capsule radius="0.015" length="0.12"/></geometry>
      <material name="leg_color"/>
    </visual>
    <collision>
      <geometry><capsule radius="0.015" length="0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.06"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.00004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="fr_knee" type="revolute">
    <parent link="fr_upper_leg"/>
    <child link="fr_lower_leg"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="0.0" effort="50" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- Front Left Upper Leg -->
  <link name="fl_upper_leg">
    <visual>
      <geometry><capsule radius="0.02" length="0.12"/></geometry>
      <material name="leg_color"/>
    </visual>
    <collision>
      <geometry><capsule radius="0.02" length="0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.06"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="fl_hip" type="revolute">
    <parent link="body"/>
    <child link="fl_upper_leg"/>
    <origin xyz="0.15 0.09 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="50" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- Front Left Lower Leg -->
  <link name="fl_lower_leg">
    <visual>
      <geometry><capsule radius="0.015" length="0.12"/></geometry>
      <material name="leg_color"/>
    </visual>
    <collision>
      <geometry><capsule radius="0.015" length="0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.06"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.00004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="fl_knee" type="revolute">
    <parent link="fl_upper_leg"/>
    <child link="fl_lower_leg"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="0.0" effort="50" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- Rear Right Upper Leg -->
  <link name="rr_upper_leg">
    <visual>
      <geometry><capsule radius="0.02" length="0.12"/></geometry>
      <material name="leg_color"/>
    </visual>
    <collision>
      <geometry><capsule radius="0.02" length="0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.06"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rr_hip" type="revolute">
    <parent link="body"/>
    <child link="rr_upper_leg"/>
    <origin xyz="-0.15 -0.09 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="50" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- Rear Right Lower Leg -->
  <link name="rr_lower_leg">
    <visual>
      <geometry><capsule radius="0.015" length="0.12"/></geometry>
      <material name="leg_color"/>
    </visual>
    <collision>
      <geometry><capsule radius="0.015" length="0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.06"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.00004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rr_knee" type="revolute">
    <parent link="rr_upper_leg"/>
    <child link="rr_lower_leg"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="0.0" effort="50" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- Rear Left Upper Leg -->
  <link name="rl_upper_leg">
    <visual>
      <geometry><capsule radius="0.02" length="0.12"/></geometry>
      <material name="leg_color"/>
    </visual>
    <collision>
      <geometry><capsule radius="0.02" length="0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.06"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rl_hip" type="revolute">
    <parent link="body"/>
    <child link="rl_upper_leg"/>
    <origin xyz="-0.15 0.09 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="50" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- Rear Left Lower Leg -->
  <link name="rl_lower_leg">
    <visual>
      <geometry><capsule radius="0.015" length="0.12"/></geometry>
      <material name="leg_color"/>
    </visual>
    <collision>
      <geometry><capsule radius="0.015" length="0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 -0.06"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.00004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="rl_knee" type="revolute">
    <parent link="rl_upper_leg"/>
    <child link="rl_lower_leg"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="0.0" effort="50" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>
</robot>
