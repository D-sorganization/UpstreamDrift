+
+        plant.CalcMassMatrixViaInverseDynamics.return_value = np.eye(2)
+        plant.num_velocities.return_value = 2
+        plant.MakeMultibodyForces.return_value = MagicMock()
+        plant.CalcInverseDynamics.return_value = np.array([0.5, 1.0])
