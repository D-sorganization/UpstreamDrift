            "distances_ft": {
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "type": "array"
            },
            "expected_putts": {
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "distances_ft",
            "expected_putts"
          ],
          "type": "object"
        },
        "distance_ft": {
          "description": "Putt length, feet (0, 100].",
          "type": "number"
        },
        "grade_pct": {
          "description": "Green slope, percent [0, 10].",
          "type": "number"
        },
        "line_sd_deg": {
          "description": "Start-line error SD, degrees.",
          "type": "number"
        },
        "n": {
          "description": "Putts per candidate.",
          "type": "integer"
        },
        "objective": {
          "enum": [
            "sg",
            "must_make"
          ],
          "type": "string"
        },
        "paces_ft": {
          "description": "Candidate paces, feet past the hole.",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "type": "array"
        },
        "seed": {
          "type": "integer"
        },
        "speed_sd": {
          "description": "Log speed-ratio error SD.",
          "type": "number"
        },
        "stimp": {
          "description": "Green speed, feet [5, 16].",
          "type": "number"
        }
      },
      "required": [
        "distance_ft",
        "baseline"
      ],
      "type": "object"
