  {
    "description": "Best aim and pace for one putt under the player's stroke noise",
    "inputSchema": {
      "properties": {
        "aims_deg": {
          "description": "Candidate aims, degrees left.",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "type": "array"
        },
        "aspect_deg": {
          "description": "Fall line, deg CCW of the hole line.",
          "type": "number"
        },
        "auth_token": {
          "type": "string"
        },
        "baseline": {
          "description": "The player's expected putts by distance; prices a miss.",
