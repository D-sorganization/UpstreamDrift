# ==============================================================================
# Docker GPU Configuration
# ==============================================================================
# Contains defaults for GPU support. Rename to .env to use.
# Requires: NVIDIA GPU + NVIDIA Container Toolkit installed on host.
#
# Examples:
#   CPU only (default):  docker compose up
#   With GPU:            docker compose -f docker-compose.yml -f docker-compose.gpu.yml up
# ==============================================================================

# GPU device selection
# Options:
#   "all"   - Use all available GPUs
#   "0"     - Use first GPU only
#   "0,1"   - Use specific GPUs by index
NVIDIA_GPU_COUNT=all

# MuJoCo rendering backend
# Options:
#   "egl"    - Headless GPU rendering (recommended for Docker)
#   "osmesa" - Software rendering (fallback, no GPU needed)
#   "glfw"   - Window-based (requires X11 forwarding)
MUJOCO_GL=egl
NVIDIA_VISIBLE_DEVICES=all
